<%@ Page Title="Métodos de cálculo" Language="vb" AutoEventWireup="false" MasterPageFile="~/Site.Master" CodeBehind="MetodosCalculo.aspx.vb" Inherits="SistemaFinanciera.MetodosCalculoAdmin" %>
<asp:Content ID="Head" ContentPlaceHolderID="HeadContent" runat="server"><style>.methods-admin{max-width:1450px;margin:0 auto}.methods-admin h1{margin:0;color:#162235;font-size:36px;font-weight:750;letter-spacing:-1px}.methods-admin .lead{margin:7px 0 22px;color:#8491a3}.methods-table{min-width:1050px}.methods-table th:last-child,.methods-table td:last-child{min-width:200px}.methods-table th{font-size:10px;letter-spacing:.05em;text-transform:uppercase;white-space:nowrap}.methods-table td{vertical-align:middle}.method-name{color:#213247;font-weight:650}.method-code{display:block;margin-top:3px;color:#8592a3;font-size:10px}.method-state{display:inline-flex;padding:5px 10px;border-radius:20px;background:#e7f5ee;color:#087849;font-size:11px;font-weight:650}.method-state.off{background:#f1f3f5;color:#758193}.method-actions{display:flex;flex-wrap:nowrap;gap:5px;white-space:nowrap}.method-action{border:0;border-radius:9px;padding:7px 9px;background:#f3f7f5;color:#087849;font-size:10px;font-weight:650;white-space:nowrap}.method-action-detail{background:#edf4ff;color:#2563bd}.method-action-detail:hover{background:#dceaff;color:#174ea6}.method-action.danger{background:#fff4f1;color:#b94e3a}.method-detail-overlay{position:fixed;inset:0;z-index:1100;display:grid;place-items:center;padding:20px;background:#18263872;backdrop-filter:blur(3px)}.method-detail{position:relative;width:min(100%,850px);max-height:88vh;overflow:auto;padding:26px;border-radius:23px;background:#fff;box-shadow:0 24px 80px #17253830}.method-detail h2{margin:0;color:#1a283a}.method-detail-footer{position:sticky;bottom:-26px;display:flex!important;justify-content:flex-end;margin:18px -26px -26px;padding:16px 26px 20px;border-top:1px solid #e8edf0;background:#fff;z-index:2}.method-close-button{display:inline-flex!important;visibility:visible!important;opacity:1!important;align-items:center;justify-content:center;gap:7px;min-height:42px;padding:0 18px;border:1px solid #0d7a48!important;border-radius:999px;background:#0d7a48!important;color:#fff!important;font-size:13px;font-weight:700;white-space:nowrap;cursor:pointer}.method-close-button:hover{border-color:#08663b!important;background:#08663b!important;color:#fff!important}.method-detail-grid{display:grid;grid-template-columns:1fr 1fr;gap:13px;margin-top:18px}.method-detail-field{padding:14px;border:1px solid #e8edf0;border-radius:14px;background:#fbfcfc}.method-detail-field small{display:block;margin-bottom:7px;color:#8190a2;font-size:10px;font-weight:700;letter-spacing:.05em;text-transform:uppercase}.method-detail-field div{color:#36465a;font-size:12px;white-space:pre-wrap;overflow-wrap:anywhere}.method-detail-field.wide{grid-column:1/-1}.methods-note{margin-top:16px;color:#8693a3;font-size:12px}@media(max-width:700px){.methods-admin h1{font-size:29px}.method-detail-grid{grid-template-columns:1fr}.method-detail-field.wide{grid-column:auto}}
.method-actions{display:flex;flex-wrap:nowrap;gap:6px;white-space:nowrap}.method-icon-action{display:inline-grid;place-items:center;width:35px;height:35px;flex:0 0 35px;border:1px solid #e6ebef;border-radius:10px;background:#f7f9fa;color:#647487;text-decoration:none;transition:background .15s ease,color .15s ease,border-color .15s ease}.method-icon-action svg{width:17px;height:17px}.method-icon-detail{background:#edf4ff;border-color:#dbe9ff;color:#2563bd}.method-icon-detail:hover{background:#dceaff;border-color:#c4dcff;color:#174ea6}.method-icon-edit{background:#f5f3ff;border-color:#e8e1ff;color:#7056c9}.method-icon-edit:hover{background:#ebe5ff;border-color:#d8ccff;color:#563bb0}.method-icon-action.state-active{background:#eff8f2;border-color:#d9eee1;color:#087849}.method-icon-action.state-active:hover{background:#fff0ef;border-color:#f4d5d1;color:#bd3f38}.method-icon-action.state-inactive{background:#f2f4f6;border-color:#e5e9ed;color:#788595}.method-icon-action.state-inactive:hover{background:#e8f5ee;border-color:#d4ecdf;color:#087849}.method-icon-action .toggle-dot{transition:transform .15s ease}.method-icon-action.state-active .toggle-dot{transform:translateX(6px)}.method-detail{width:min(100%,980px)}.method-close-button{background:#0d7a48!important;border-color:#0d7a48!important;color:#fff!important}.method-close-button:hover{background:#08663b!important;border-color:#08663b!important;color:#fff!important}.method-edit-dialog{width:min(100%,980px);max-height:90vh;overflow:auto;scrollbar-width:none;-ms-overflow-style:none;padding:28px;border:1px solid #e6ebef;border-radius:23px;background:#fff;box-shadow:0 25px 80px #17253830}.method-edit-dialog::-webkit-scrollbar{display:none;width:0;height:0}.method-edit-dialog h2{margin:0;color:#19283a}.method-edit-lead{margin:7px 0 18px;color:#8290a1;font-size:13px;line-height:1.5}.method-edit-code{margin:0 0 15px;padding:11px 14px;border:1px solid #e8edf0;border-radius:12px;background:#f7f9fa;color:#657487;font-size:12px}.method-edit-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.method-edit-field{min-width:0}.method-edit-field.wide{grid-column:1/-1}.method-edit-field label{display:block;margin:0 0 6px;color:#53657a;font-size:12px;font-weight:650}.method-edit-field textarea{min-height:88px;resize:vertical}.method-edit-note{margin:15px 0 0;padding:11px 13px;border-radius:12px;background:#f4f8fb;color:#708093;font-size:11px;line-height:1.5}.method-edit-actions{display:flex;justify-content:flex-end;gap:10px;margin-top:20px;padding-top:16px;border-top:1px solid #e9edf0}@media(max-width:700px){.method-edit-dialog{padding:20px}.method-edit-grid{grid-template-columns:1fr}.method-edit-field.wide{grid-column:auto}}.method-actions .action-icon{display:inline-grid;place-items:center;width:32px;height:32px;flex:0 0 32px;margin:0 1px;border:0;border-radius:10px;background:transparent;color:#98a3b3;text-decoration:none;transition:background-color .16s ease,color .16s ease,transform .16s ease}.method-actions .action-svg{display:block;width:17px;height:17px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}.method-actions .action-icon:hover,.method-actions .action-icon:focus-visible{transform:translateY(-1px)}.method-actions .action-view:hover,.method-actions .action-view:focus-visible{background:#e9f8ef;color:#07834d}.method-actions .action-edit:hover,.method-actions .action-edit:focus-visible{background:#edf3ff;color:#2563eb}.method-actions .action-toggle:hover,.method-actions .action-toggle:focus-visible{background:#fff6e6;color:#d97706}.method-actions .action-icon:focus-visible{outline:2px solid currentColor;outline-offset:2px}.method-detail-footer{position:sticky;bottom:-26px;display:flex!important;justify-content:flex-end;margin:18px -26px -26px;padding:16px 26px 20px;border-top:1px solid #e8edf0;background:#fff;z-index:2}.method-close-button{display:inline-flex!important;visibility:visible!important;opacity:1!important;align-items:center;justify-content:center;min-height:42px;padding:0 18px;border:1px solid #0d7a48!important;border-radius:999px;background:#0d7a48!important;color:#fff!important;font-size:13px;font-weight:700;white-space:nowrap;cursor:pointer}.method-close-button:hover{background:#08663b!important;color:#fff!important}.modal-error{display:block;padding:11px 13px;border:1px solid #f5d5cb;border-radius:12px;background:#fff4f1;color:#b94e3a;font-size:12px;line-height:1.5;white-space:pre-wrap;overflow-wrap:anywhere}.modal-preview{display:block;max-height:270px;overflow:auto;border:1px solid #e8edf0;border-radius:12px}.modal-preview .preview-caption{display:block;padding:9px 10px 3px;color:#657487;font-size:11px;font-weight:650}.modal-preview table{width:100%;border-collapse:collapse;font-size:11px}.modal-preview th{position:sticky;top:0;background:#f7f9fa;color:#657487;font-size:9px;letter-spacing:.05em;text-transform:uppercase;padding:7px 8px;text-align:right;border-bottom:1px solid #e8edf0}.modal-preview td{padding:6px 8px;text-align:right;color:#36465a;border-bottom:1px solid #f2f5f7;font-variant-numeric:tabular-nums}.modal-preview th:first-child,.modal-preview td:first-child{text-align:left}.admin-help{display:block;margin-top:5px;color:#8190a2;font-size:10.5px;line-height:1.45}</style></asp:Content>
<asp:Content ID="Body" ContentPlaceHolderID="MainContent" runat="server"><div class="finance-page methods-admin"><div id="pnlMensaje" runat="server" class="alert" role="status" aria-live="polite"><asp:Literal ID="mensaje" runat="server" Mode="Encode"/></div><asp:Panel ID="contenidoAdmin" runat="server"><header style="display:flex;justify-content:space-between;align-items:flex-end;gap:18px"><div><div class="eyebrow">CapitalWest / Administración</div><h1>Métodos de cálculo</h1><p class="lead">Consulta su lógica implementada y controla cuáles están disponibles para nuevas operaciones.</p></div><asp:Button ID="btnNuevoMetodo" runat="server" Text="＋ Nuevo método" CssClass="btn btn-primary" CausesValidation="false"/></header><section class="cw-card"><div class="admin-section-title"><div><h2>Métodos disponibles</h2><p>Los contratos ya formalizados conservan su calendario y condiciones.</p></div><span class="admin-role-chip">Catálogo protegido</span></div><div class="table-responsive"><asp:GridView ID="grMetodos" runat="server" AutoGenerateColumns="false" DataKeyNames="Id,Codigo,Nombre,Descripcion,ClaseImplementacion,Formula,Variables,Algoritmo,EjemploManual,Activo,PrestamosAsociados,ExprInteres,ExprCapital,ExprSaldo" CssClass="table table-hover methods-table" GridLines="None" EmptyDataText="No hay métodos registrados." OnRowDataBound="MetodosRowDataBound"><Columns><asp:TemplateField HeaderText="Método"><ItemTemplate><span class="method-name"><%#: Eval("Nombre") %></span><span class="method-code"><%#: Eval("Codigo") %></span></ItemTemplate></asp:TemplateField><asp:BoundField DataField="Descripcion" HeaderText="Descripción"/><asp:BoundField DataField="ClaseImplementacion" HeaderText="Implementación" NullDisplayText="Pendiente"/><asp:TemplateField HeaderText="Préstamos vinculados"><ItemTemplate><%#: Eval("PrestamosAsociados") %></ItemTemplate></asp:TemplateField><asp:TemplateField HeaderText="Estado"><ItemTemplate><span class='method-state <%# If(CBool(Eval("Activo")), "", "off") %>'><%# If(CBool(Eval("Activo")), "Activo", "Inactivo") %></span></ItemTemplate></asp:TemplateField><asp:TemplateField HeaderText="Acciones"><ItemTemplate><div class="method-actions"><asp:LinkButton runat="server" CommandName="Detalle" CommandArgument='<%# Container.DisplayIndex %>' CssClass="action-icon action-view" CausesValidation="false" ToolTip="Ver detalle" aria-label="Ver detalle"><svg class="action-svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M2.5 12s3.4-6 9.5-6 9.5 6 9.5 6-3.4 6-9.5 6-9.5-6-9.5-6Z"/><circle cx="12" cy="12" r="2.8"/></svg></asp:LinkButton><asp:LinkButton runat="server" CommandName="Editar" CommandArgument='<%# Container.DisplayIndex %>' CssClass="action-icon action-edit" CausesValidation="false" ToolTip="Editar ficha del método" aria-label="Editar método"><svg class="action-svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m14.5 6.5 3 3M4 20l4.4-.9L19 8.5a2.1 2.1 0 0 0-3-3L5.4 16.1 4 20Z"/></svg></asp:LinkButton><asp:LinkButton runat="server" ID="lnkEstadoMetodo" CommandName="Estado" CommandArgument='<%# Container.DisplayIndex %>' CssClass="action-icon action-toggle" CausesValidation="false"><svg class="action-svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9"/><path d="m5.6 5.6 12.8 12.8"/></svg><span class="sr-only"><%# If(CBool(Eval("Activo")), "Desactivar método", "Activar método") %></span></asp:LinkButton></div></ItemTemplate></asp:TemplateField></Columns></asp:GridView></div><p class="methods-note">Los métodos nuevos definen su propio sistema de cálculo: declare las variables y las fórmulas de interes, capital y saldo que ejecutará el motor. Use «Probar calendario» para ver un ejemplo antes de guardar; el sistema exige que el calendario cierre con 1, 3 y 12 cuotas.</p></section></asp:Panel><asp:Panel ID="modalDetalle" runat="server" Visible="false" CssClass="method-detail-overlay" role="dialog" aria-modal="true" aria-labelledby="tituloMetodoDetalle" onclick="if(event.target===this){document.getElementById(&quot;btnCerrar&quot;).click();}"><section class="method-detail"><div class="admin-section-title"><div><div class="eyebrow">FÓRMULA Y FUNCIONAMIENTO</div><h2 id="tituloMetodoDetalle"><asp:Literal ID="litNombre" runat="server" Mode="Encode"/></h2><p><asp:Literal ID="litCodigo" runat="server" Mode="Encode"/></p></div></div><div class="method-detail-grid"><div class="method-detail-field wide"><small>Descripción</small><div><asp:Literal ID="litDescripcion" runat="server" Mode="Encode"/></div></div><div class="method-detail-field"><small>Clase implementada</small><div><asp:Literal ID="litClase" runat="server" Mode="Encode"/></div></div><asp:Panel ID="pnlExprInteresDetalle" runat="server" CssClass="method-detail-field wide" Visible="false"><small>Fórmula de interes</small><div><asp:Literal ID="litExprInteres" runat="server" Mode="Encode"/></div></asp:Panel><asp:Panel ID="pnlExprCapitalDetalle" runat="server" CssClass="method-detail-field wide" Visible="false"><small>Fórmula de capital</small><div><asp:Literal ID="litExprCapital" runat="server" Mode="Encode"/></div></asp:Panel><asp:Panel ID="pnlExprSaldoDetalle" runat="server" CssClass="method-detail-field wide" Visible="false"><small>Fórmula de saldo</small><div><asp:Literal ID="litExprSaldo" runat="server" Mode="Encode"/></div></asp:Panel><div class="method-detail-field"><small>Fórmula</small><div><asp:Literal ID="litFormula" runat="server" Mode="Encode"/></div></div><div class="method-detail-field wide"><small>Variables</small><div><asp:Literal ID="litVariables" runat="server" Mode="Encode"/></div></div><div class="method-detail-field wide"><small>Algoritmo</small><div><asp:Literal ID="litAlgoritmo" runat="server" Mode="Encode"/></div></div><div class="method-detail-field wide"><small>Ejemplo manual</small><div><asp:Literal ID="litEjemplo" runat="server" Mode="Encode"/></div></div></div><div class="method-detail-footer"><asp:Button ID="btnCerrar" runat="server" ClientIDMode="Static" Text="× Cerrar" CssClass="btn method-close-button" CausesValidation="false" UseSubmitBehavior="false" aria-label="Cerrar detalle del método"/></div></section></asp:Panel><asp:Panel ID="modalEditarMetodo" runat="server" Visible="false" CssClass="method-detail-overlay" role="dialog" aria-modal="true" aria-labelledby="tituloEditarMetodo"><section class="method-edit-dialog"><div class="eyebrow">ADMINISTRACIÓN / MÉTODOS</div><h2 id="tituloEditarMetodo">Editar método de cálculo</h2><p class="method-edit-lead">Actualiza la ficha del método. Si el método usa fórmulas propias, también puede corregirlas; el sistema valida el calendario antes de guardar.</p><asp:HiddenField ID="hfMetodoId" runat="server"/><div class="method-edit-code">Código del método: <strong><asp:Literal ID="litCodigoEditar" runat="server" Mode="Encode"/></strong></div><div class="method-edit-grid"><div class="method-edit-field"><label for="txtNombreMetodo">Nombre</label><asp:TextBox ID="txtNombreMetodo" runat="server" CssClass="form-control" MaxLength="50" required="required" data-method-max="50" /><small id="txtNombreMetodoAyuda" class="admin-help">Máx. 50 caracteres</small></div><div class="method-edit-field wide"><label for="txtDescripcionMetodo">Descripción</label><asp:TextBox ID="txtDescripcionMetodo" runat="server" CssClass="form-control" MaxLength="200" TextMode="MultiLine" Rows="2" required="required" data-method-max="200" /><small id="txtDescripcionMetodoAyuda" class="admin-help">Máx. 200 caracteres</small></div><div class="method-edit-field wide"><label for="txtFormulaMetodo">Fórmula</label><asp:TextBox ID="txtFormulaMetodo" runat="server" CssClass="form-control" MaxLength="1000" TextMode="MultiLine" Rows="3" data-method-max="1000" /><small id="txtFormulaMetodoAyuda" class="admin-help">Opcional · Máx. 1000 caracteres</small></div><div class="method-edit-field wide"><label for="txtVariablesMetodo">Variables (definiciones)</label><asp:TextBox ID="txtVariablesMetodo" runat="server" CssClass="form-control" MaxLength="2000" TextMode="MultiLine" Rows="2" data-method-max="2000" /><small id="txtVariablesMetodoAyuda" class="admin-help">Una definición por línea · Máx. 2000 caracteres</small></div><asp:Panel ID="pnlExprInteresEditar" runat="server" CssClass="method-edit-field wide" Visible="false"><label for="txtExprInteresMetodo">Fórmula de interes</label><asp:TextBox ID="txtExprInteresMetodo" runat="server" CssClass="form-control" MaxLength="500" TextMode="MultiLine" Rows="2" required="required" data-method-max="500" /><small id="txtExprInteresMetodoAyuda" class="admin-help">Obligatoria · Máx. 500 caracteres</small></asp:Panel><asp:Panel ID="pnlExprCapitalEditar" runat="server" CssClass="method-edit-field wide" Visible="false"><label for="txtExprCapitalMetodo">Fórmula de capital</label><asp:TextBox ID="txtExprCapitalMetodo" runat="server" CssClass="form-control" MaxLength="500" TextMode="MultiLine" Rows="2" required="required" data-method-max="500" /><small id="txtExprCapitalMetodoAyuda" class="admin-help">Obligatoria · Máx. 500 caracteres</small></asp:Panel><asp:Panel ID="pnlExprSaldoEditar" runat="server" CssClass="method-edit-field wide" Visible="false"><label for="txtExprSaldoMetodo">Fórmula de saldo (opcional; vacío = saldo - capital)</label><asp:TextBox ID="txtExprSaldoMetodo" runat="server" CssClass="form-control" MaxLength="500" TextMode="MultiLine" Rows="2" data-method-max="500" /><small id="txtExprSaldoMetodoAyuda" class="admin-help">Opcional: saldo - capital · Máx. 500 caracteres</small></asp:Panel><asp:Panel ID="pnlErrorEditar" runat="server" CssClass="method-edit-field wide" Visible="false"><div class="modal-error" role="alert"><asp:Literal ID="litErrorEditar" runat="server" Mode="Encode"/></div></asp:Panel><div class="method-edit-field wide"><label for="txtAlgoritmoMetodo">Algoritmo</label><asp:TextBox ID="txtAlgoritmoMetodo" runat="server" CssClass="form-control" MaxLength="1000" TextMode="MultiLine" Rows="3" data-method-max="1000" /><small id="txtAlgoritmoMetodoAyuda" class="admin-help">Opcional · Máx. 1000 caracteres</small></div><div class="method-edit-field wide"><label for="txtEjemploMetodo">Ejemplo manual</label><asp:TextBox ID="txtEjemploMetodo" runat="server" CssClass="form-control" MaxLength="1000" TextMode="MultiLine" Rows="2" data-method-max="1000" /><small id="txtEjemploMetodoAyuda" class="admin-help">Opcional · Máx. 1000 caracteres</small></div></div><p class="method-edit-note">Los cambios se validan con una prueba de calendario (1, 3 y 12 cuotas) antes de guardarse. Los contratos ya formalizados conservan su calendario y condiciones.</p><div class="method-edit-actions"><asp:Button ID="btnCancelarEdicion" runat="server" Text="Cancelar" CssClass="btn btn-light" CausesValidation="false"/><asp:Button ID="btnGuardarMetodo" runat="server" Text="Guardar cambios" CssClass="btn btn-primary"/></div></section></asp:Panel><asp:Panel ID="modalCrearMetodo" runat="server" Visible="false" CssClass="method-detail-overlay" role="dialog" aria-modal="true" aria-labelledby="tituloCrearMetodo" onclick="if(event.target===this){document.getElementById(&quot;btnCancelarCreacion&quot;).click();}"><section class="method-edit-dialog"><div class="eyebrow">ADMINISTRACIÓN / MÉTODOS</div><h2 id="tituloCrearMetodo">Nuevo método de cálculo</h2><p class="method-edit-lead">Define un sistema de cálculo propio: declare las variables y las fórmulas de interes, capital y saldo que el motor ejecutará cuota por cuota.</p><div class="method-edit-grid"><div class="method-edit-field"><label for="<%= txtCodigoNuevoMetodo.ClientID %>">Código</label><asp:TextBox ID="txtCodigoNuevoMetodo" runat="server" CssClass="form-control" MaxLength="20" required="required" placeholder="FRANCES_PYME" minlength="2" data-method-field="Codigo" data-method-limit="20" aria-describedby="txtCodigoNuevoMetodoAyuda"  data-method-max="20" /><small id="txtCodigoNuevoMetodoAyuda" class="admin-help">2–20 caracteres · Letras, números y _</small></div><div class="method-edit-field"><label for="<%= txtNombreNuevoMetodo.ClientID %>">Nombre</label><asp:TextBox ID="txtNombreNuevoMetodo" runat="server" CssClass="form-control" MaxLength="50" required="required" placeholder="Sistema francés PyME" data-method-field="Nombre" data-method-limit="50" aria-describedby="txtNombreNuevoMetodoAyuda"  data-method-max="50" /><small id="txtNombreNuevoMetodoAyuda" class="admin-help">Máx. 50 caracteres</small></div><div class="method-edit-field wide"><label for="<%= txtDescripcionNuevoMetodo.ClientID %>">Descripción</label><asp:TextBox ID="txtDescripcionNuevoMetodo" runat="server" CssClass="form-control" MaxLength="200" TextMode="MultiLine" Rows="2" required="required" data-method-field="Descripcion" data-method-limit="200" aria-describedby="txtDescripcionNuevoMetodoAyuda"  data-method-max="200" /><small id="txtDescripcionNuevoMetodoAyuda" class="admin-help">Máx. 200 caracteres</small></div><div class="method-edit-field wide"><label for="<%= txtVariablesNuevoMetodo.ClientID %>">Variables (definiciones)</label><asp:TextBox ID="txtVariablesNuevoMetodo" runat="server" CssClass="form-control" MaxLength="2000" TextMode="MultiLine" Rows="3" placeholder="cuota = P*i/(1-(1+i)^(-n))&#10;total = round(P*r/100*n/f)" data-method-field="Variables" data-method-limit="2000" aria-describedby="txtVariablesNuevoMetodoAyuda"  data-method-max="2000" /><small id="txtVariablesNuevoMetodoAyuda" class="admin-help">Una definición por línea · Máx. 2000 caracteres</small></div><div class="method-edit-field wide"><label for="<%= txtExprInteresNuevoMetodo.ClientID %>">Fórmula de interes (obligatoria)</label><asp:TextBox ID="txtExprInteresNuevoMetodo" runat="server" CssClass="form-control" MaxLength="500" TextMode="MultiLine" Rows="2" required="required" placeholder="round(saldo*i)" data-method-field="ExprInteres" data-method-limit="500" aria-describedby="txtExprInteresNuevoMetodoAyuda"  data-method-max="500" /><small id="txtExprInteresNuevoMetodoAyuda" class="admin-help">Obligatoria · Máx. 500 caracteres</small></div><div class="method-edit-field wide"><label for="<%= txtExprCapitalNuevoMetodo.ClientID %>">Fórmula de capital (obligatoria)</label><asp:TextBox ID="txtExprCapitalNuevoMetodo" runat="server" CssClass="form-control" MaxLength="500" TextMode="MultiLine" Rows="2" required="required" placeholder="if(k=n, saldo, min(saldo, round(cuota - interes)))" data-method-field="ExprCapital" data-method-limit="500" aria-describedby="txtExprCapitalNuevoMetodoAyuda"  data-method-max="500" /><small id="txtExprCapitalNuevoMetodoAyuda" class="admin-help">Obligatoria · Máx. 500 caracteres</small></div><div class="method-edit-field wide"><label for="<%= txtExprSaldoNuevoMetodo.ClientID %>">Fórmula de saldo (opcional)</label><asp:TextBox ID="txtExprSaldoNuevoMetodo" runat="server" CssClass="form-control" MaxLength="500" TextMode="MultiLine" Rows="2" placeholder="saldo - capital" data-method-field="ExprSaldo" data-method-limit="500" aria-describedby="txtExprSaldoNuevoMetodoAyuda"  data-method-max="500" /><small id="txtExprSaldoNuevoMetodoAyuda" class="admin-help">Opcional: saldo - capital · Máx. 500 caracteres</small></div><div class="method-edit-field wide"><label for="<%= txtFormulaNuevoMetodo.ClientID %>">Fórmula (documentación)</label><asp:TextBox ID="txtFormulaNuevoMetodo" runat="server" CssClass="form-control" MaxLength="1000" TextMode="MultiLine" Rows="3" placeholder="C = P*i/(1-(1+i)^(-n))" data-method-field="Formula" data-method-limit="1000" aria-describedby="txtFormulaNuevoMetodoAyuda"  data-method-max="1000" /><small id="txtFormulaNuevoMetodoAyuda" class="admin-help">Opcional · Máx. 1000 caracteres</small></div><div class="method-edit-field wide"><label for="<%= txtAlgoritmoNuevoMetodo.ClientID %>">Algoritmo</label><asp:TextBox ID="txtAlgoritmoNuevoMetodo" runat="server" CssClass="form-control" MaxLength="1000" TextMode="MultiLine" Rows="3" data-method-field="Algoritmo" data-method-limit="1000" aria-describedby="txtAlgoritmoNuevoMetodoAyuda"  data-method-max="1000" /><small id="txtAlgoritmoNuevoMetodoAyuda" class="admin-help">Opcional · Máx. 1000 caracteres</small></div><div class="method-edit-field wide"><label for="<%= txtEjemploNuevoMetodo.ClientID %>">Ejemplo manual</label><asp:TextBox ID="txtEjemploNuevoMetodo" runat="server" CssClass="form-control" MaxLength="1000" TextMode="MultiLine" Rows="2" data-method-field="Ejemplo" data-method-limit="1000" aria-describedby="txtEjemploNuevoMetodoAyuda"  data-method-max="1000" /><small id="txtEjemploNuevoMetodoAyuda" class="admin-help">Opcional · Máx. 1000 caracteres</small></div></div><details class="method-edit-note"><summary>Ayuda para las fórmulas</summary><p>Variables: P, i, r, n, k, saldo, f, interes_acum y capital_acum. Defina nombre = expresión, una por línea; máximo 30 definiciones sin nombres repetidos ni reservados. Use punto decimal. La fórmula de capital puede usar interes. # inicia un comentario.</p><p>El código debe empezar con una letra y ser único. Los códigos FRANCES, ALEMAN, AMERICANO, SIMPLE y COMPUESTO están reservados. Use Probar calendario para verificar las fórmulas.</p></details><asp:Panel ID="pnlErrorCrear" runat="server" CssClass="method-edit-field wide" Visible="false"><div class="modal-error" role="alert"><asp:Literal ID="litErrorCrear" runat="server" Mode="Encode"/></div></asp:Panel><asp:Panel ID="pnlPreviewCrear" runat="server" CssClass="method-edit-field wide" Visible="false"><div class="modal-preview"><asp:Literal ID="litPreviewCrear" runat="server" Mode="Encode"/></div></asp:Panel><p class="method-edit-note">Tras crearlo, asócialo a uno o más productos para poder usarlo en el simulador y en las solicitudes. El método nace activo.</p><div class="method-edit-actions"><asp:Button ID="btnProbarNuevoMetodo" runat="server" Text="Probar calendario" CssClass="btn btn-light" CausesValidation="false"/><asp:Button ID="btnCancelarCreacion" runat="server" ClientIDMode="Static" Text="Cancelar" CssClass="btn btn-light" CausesValidation="false" UseSubmitBehavior="false" formnovalidate="formnovalidate" OnClientClick="this.form.noValidate=true; var overlay=this.closest('.method-detail-overlay'); if(overlay){overlay.style.display='none';}"/><asp:Button ID="btnGuardarNuevoMetodo" runat="server" Text="Crear método" CssClass="btn btn-primary"/></div></section></asp:Panel></div><script>
document.addEventListener('DOMContentLoaded', function () {
 document.querySelectorAll('[data-method-max]').forEach(f=>f.maxLength=Number(f.dataset.methodMax));
 const panel=document.getElementById('<%= modalCrearMetodo.ClientID %>'); if(!panel)return;
 const fields=Array.from(panel.querySelectorAll('[data-method-field]'));
 const formulaKeys=['Variables','ExprInteres','ExprCapital','ExprSaldo'];
 const reserved=['FRANCES','ALEMAN','AMERICANO','SIMPLE','COMPUESTO'];
 function validate(field){
  const key=field.dataset.methodField, value=field.value, trim=value.trim();let error='';
  if(key==='Codigo')field.value=trim.toUpperCase();
  if(field.required&&!trim)error='Este campo es obligatorio.';
  else if(value.length>Number(field.dataset.methodLimit))error='Máximo '+field.dataset.methodLimit+' caracteres.';
  else if(key==='Codigo'&&(!/^[A-Z][A-Z0-9_]{1,19}$/.test(field.value)||reserved.includes(field.value)))error='Use un código de 2–20 caracteres: letras, números y guion bajo, comenzando por letra. Los códigos nativos están reservados.';
  else if(/[\x00-\x08\x0B\x0C\x0E-\x1F\x7F\u200B-\u200F\u202A-\u202E\u2060-\u206F\uFEFF]/.test(value))error='Elimine caracteres de control o invisibles.';
  else if(!formulaKeys.includes(key)&&/[<>]/.test(value))error='No se permite HTML ni los caracteres < y > en este campo.';
  let hint=document.getElementById(field.id+'Error');
  if(!hint){hint=document.createElement('small');hint.id=field.id+'Error';hint.className='field-validation-error';hint.setAttribute('role','alert');field.insertAdjacentElement('afterend',hint);}
  hint.textContent=error;hint.hidden=!error;field.classList.toggle('is-invalid',!!error);field.setAttribute('aria-invalid',String(!!error));
  field.setAttribute('aria-describedby', 'txt'+key+'NuevoMetodoAyuda'+(error?' '+hint.id:''));return !error;
 }
 fields.forEach(field=>{field.setAttribute('maxlength',field.dataset.methodLimit);field.addEventListener('blur',()=>validate(field));field.addEventListener('input',()=>{if(field.classList.contains('is-invalid'))validate(field);});});
 function check(event, preview){let first;fields.filter(f=>!preview||formulaKeys.includes(f.dataset.methodField)).forEach(f=>{if(!validate(f)&&!first)first=f;});if(first){event.preventDefault();event.stopImmediatePropagation();first.focus();}}
 document.getElementById('<%= btnGuardarNuevoMetodo.ClientID %>').addEventListener('click',e=>check(e,false),true);
 document.getElementById('<%= btnProbarNuevoMetodo.ClientID %>').addEventListener('click',e=>check(e,true),true);
});
</script></asp:Content>