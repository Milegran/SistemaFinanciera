<style>
.admin-page{max-width:1500px;margin:0 auto}.admin-heading{display:flex;justify-content:space-between;align-items:flex-end;gap:18px;margin-bottom:22px}.admin-heading h1{margin:0;color:#162235;font-size:36px;font-weight:750;letter-spacing:-1px}.admin-heading p{margin:7px 0 0;color:#8491a3}.admin-kpis{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:15px;margin:20px 0}.admin-kpi{display:block;width:100%;padding:20px 22px;border:1px solid #e0e6eb;border-radius:20px;background:#fff;box-shadow:0 8px 24px #18263808;text-align:left;text-decoration:none;color:inherit;cursor:pointer;transition:transform .2s ease,border-color .2s ease,background .2s ease,box-shadow .2s ease}.admin-kpi:hover,.admin-kpi:focus-visible,.admin-kpi.is-selected{transform:translateY(-3px);border-color:#8bd6ad;background:linear-gradient(135deg,#fff 0%,#f4fcf7 100%);box-shadow:0 14px 30px rgba(13,122,72,.14),0 0 0 5px rgba(13,122,72,.055);outline:none}.admin-kpi:active{transform:translateY(-1px);box-shadow:0 7px 16px rgba(13,122,72,.12),0 0 0 3px rgba(13,122,72,.05)}.admin-kpi:focus-visible{outline:2px solid #0d7a48;outline-offset:3px}.admin-kpi span{display:block;color:#8491a3;font-size:11px;font-weight:700;letter-spacing:.06em;text-transform:uppercase}.admin-kpi strong{display:block;margin-top:9px;color:#172538;font-size:27px}.admin-kpi em{display:block;margin-top:4px;color:#0d8050;font-size:12px;font-style:normal}.admin-tools{display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap;margin-bottom:18px}.admin-search{display:flex;gap:10px;flex:1;min-width:min(100%,300px)}.admin-search .form-control{max-width:420px}.admin-filters{display:flex;gap:10px;flex-wrap:wrap}.admin-filters select{min-width:165px}.admin-section-title{display:flex;align-items:center;justify-content:space-between;gap:14px;margin-bottom:16px}.admin-section-title h2{margin:0;font-size:19px;color:#172538}.admin-section-title p{margin:5px 0 0;color:#8491a3;font-size:12px}.admin-table{min-width:920px}.admin-table th{font-size:10px;letter-spacing:.04em;text-transform:uppercase;white-space:nowrap}.admin-table td{vertical-align:middle}.admin-user-name{font-weight:650;color:#1c2a3d}.admin-user-id{color:#8190a2;font-size:11px}.admin-role-chip,.admin-state{display:inline-flex;padding:5px 9px;border-radius:20px;background:#edf7f2;color:#087849;font-size:11px;font-weight:650}.admin-state.off{background:#f1f3f5;color:#778394}.admin-actions{display:flex;gap:5px;white-space:nowrap}.admin-action{border:0;border-radius:9px;padding:8px 10px;background:#f4f7f8;color:#657487;font-size:11px;font-weight:650}.admin-action:hover{background:#e8f5ee;color:#087849}.admin-action.danger:hover{background:#fff0ef;color:#c33d3d}.admin-shortcuts{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;margin-top:20px}.admin-shortcut{display:flex;align-items:center;gap:13px;padding:16px;border:1px solid #e5eaee;border-radius:17px;background:#fff;color:inherit;text-decoration:none;transition:transform .16s ease,border-color .16s ease}.admin-shortcut:hover{transform:translateY(-2px);border-color:#9ed8bd;color:inherit}.admin-shortcut-icon{display:grid;place-items:center;width:42px;height:42px;flex:none;border-radius:13px;background:#e7f5ee;color:#087849}.admin-shortcut-icon svg{width:21px;height:21px}.admin-shortcut strong{display:block;color:#243449;font-size:13px}.admin-shortcut small{display:block;margin-top:3px;color:#8793a3;font-size:11px}.admin-overlay{position:fixed;inset:0;z-index:1100;display:grid;place-items:center;padding:20px;background:#18263872;backdrop-filter:blur(3px)}.admin-dialog{width:min(100%,720px);max-height:min(90vh,850px);overflow:auto;padding:26px;border:1px solid #e6ebef;border-radius:24px;background:#fff;box-shadow:0 25px 80px #17253830}.admin-dialog h2{margin:0;color:#182638;font-size:22px}.admin-dialog-lead{margin:6px 0 20px;color:#8290a1;font-size:13px}.admin-dialog-grid{display:grid;grid-template-columns:1fr 1fr;gap:15px}.admin-dialog-grid .wide{grid-column:1/-1}.admin-form-actions{display:flex;justify-content:flex-end;gap:10px;margin-top:22px;padding-top:17px;border-top:1px solid #edf0f2}.admin-result{display:block;margin:12px 0;padding:12px 14px;border-radius:12px;background:#edf8f2;color:#176a46;overflow-wrap:anywhere}.admin-help{display:block;margin-top:5px;color:#8995a5;font-size:11px}.admin-warning{color:#c85140}@media(max-width:850px){.admin-kpis{grid-template-columns:repeat(2,minmax(0,1fr))}.admin-shortcuts{grid-template-columns:1fr 1fr}}@media(max-width:600px){.admin-heading{align-items:flex-start;flex-direction:column}.admin-heading h1{font-size:29px}.admin-kpis{gap:9px}.admin-kpi{padding:15px}.admin-kpi strong{font-size:22px}.admin-shortcuts,.admin-dialog-grid{grid-template-columns:1fr}.admin-dialog-grid .wide{grid-column:auto}.admin-search{flex-direction:column}.admin-search .form-control{max-width:none}}
.client-filters--admin{grid-template-columns:minmax(240px,1fr) minmax(165px,190px) minmax(165px,190px) auto;margin:0 0 26px}.client-filters--admin .form-control,.client-filters--admin .form-select{width:100%}.client-filters--admin .filter-actions{gap:6px}.admin-users-list{margin-top:0}@media(max-width:920px){.client-filters--admin{grid-template-columns:minmax(0,1fr) minmax(165px,1fr)}.client-filters--admin>div:first-child{grid-column:1/-1}.client-filters--admin .filter-actions{justify-content:flex-end}}@media(max-width:560px){.client-filters--admin{grid-template-columns:1fr}.client-filters--admin>div:first-child{grid-column:auto}.client-filters--admin .filter-actions{justify-content:stretch}.client-filters--admin .filter-actions .btn{flex:1}}
