<div class="finance-page admin-page">
 <div id="pnlMensaje" runat="server" class="alert" role="status" aria-live="polite"><asp:Literal ID="mensaje" runat="server" Mode="Encode" /></div>
 <asp:Panel ID="contenidoAdmin" runat="server">
