  <div class="admin-kpis" aria-label="Resumen de usuarios"><button type="button" class="admin-kpi" data-admin-state-filter="TODOS" aria-pressed="false"><span>Usuarios registrados</span><strong><asp:Literal ID="kpiTotal" runat="server" Mode="Encode" /></strong><em>Ver todas las cuentas ↗</em></button><button type="button" class="admin-kpi" data-admin-state-filter="ACTIVO" aria-pressed="false"><span>Usuarios activos</span><strong><asp:Literal ID="kpiActivos" runat="server" Mode="Encode" /></strong><em>Ver cuentas con acceso ↗</em></button><button type="button" class="admin-kpi" data-admin-state-filter="INACTIVO" aria-pressed="false"><span>Usuarios inactivos</span><strong><asp:Literal ID="kpiInactivos" runat="server" Mode="Encode" /></strong><em>Ver cuentas conservadas ↗</em></button><a class="admin-kpi" href="<%= ResolveUrl("~/Administracion/Roles.aspx") %>" aria-label="Ver roles disponibles"><span>Roles disponibles</span><strong><asp:Literal ID="kpiRoles" runat="server" Mode="Encode" /></strong><em>Administrar perfiles ↗</em></a></div>
  <div class="client-filters client-filters--admin">
   <div><label class="sr-only" for="<%= txtBuscar.ClientID %>">Buscar usuarios</label><asp:TextBox ID="txtBuscar" runat="server" CssClass="form-control" MaxLength="100" placeholder="Buscar por nombre, usuario o correo..." /></div>
   <div><label class="sr-only" for="<%= ddlRolFiltro.ClientID %>">Filtrar por rol</label><asp:DropDownList ID="ddlRolFiltro" runat="server" CssClass="form-select" AutoPostBack="true" /></div>
   <div><label class="sr-only" for="<%= ddlEstadoFiltro.ClientID %>">Filtrar por estado</label><asp:DropDownList ID="ddlEstadoFiltro" runat="server" CssClass="form-select" AutoPostBack="true"><asp:ListItem Text="Estado: Todos" Value="TODOS"/><asp:ListItem Text="Activos" Value="ACTIVO"/><asp:ListItem Text="Inactivos" Value="INACTIVO"/></asp:DropDownList></div>
   <div class="filter-actions"><asp:Button ID="btnBuscar" runat="server" Text="Buscar" CssClass="btn btn-outline-primary" CausesValidation="false"/><asp:Button ID="btnLimpiar" runat="server" Text="↺" ToolTip="Limpiar filtros" CssClass="btn btn-light" CausesValidation="false"/></div>
  </div>
  <section class="cw-card client-list admin-users-list"><div class="list-caption"><div><strong>Listado de usuarios</strong><small>Usuarios registrados y acceso a la plataforma</small></div></div>
    <div class="table-responsive"><asp:GridView ID="grUsuarios" runat="server" AutoGenerateColumns="false" DataKeyNames="Id,NombreUsuario,NombreCompleto,Correo,RolIds,Activo" AllowPaging="true" PageSize="15" CssClass="table table-hover align-middle" GridLines="None" EmptyDataText="No hay usuarios que coincidan con estos filtros." OnRowCommand="UsuarioCommand" OnPageIndexChanging="PaginarUsuarios" OnRowDataBound="UsuariosRowDataBound"><Columns><asp:TemplateField HeaderText="Usuario"><ItemTemplate><div class="admin-user-name"><%#: Eval("NombreCompleto") %></div><div class="admin-user-id">@<%#: Eval("NombreUsuario") %></div></ItemTemplate></asp:TemplateField><asp:BoundField DataField="Correo" HeaderText="Correo"/><asp:TemplateField HeaderText="Rol"><ItemTemplate><span class="admin-role-chip"><%#: Eval("Rol") %></span></ItemTemplate></asp:TemplateField><asp:TemplateField HeaderText="Estado"><ItemTemplate><span class='admin-state <%# If(CBool(Eval("Activo")), "", "off") %>'><%# If(CBool(Eval("Activo")), "Activo", "Inactivo") %></span></ItemTemplate></asp:TemplateField><asp:BoundField DataField="UltimoAcceso" HeaderText="Último acceso" NullDisplayText="Nunca"/><asp:TemplateField HeaderText="Acciones"><ItemTemplate><div class="admin-actions"><asp:LinkButton runat="server" CommandName="EditarUsuario" CommandArgument='<%# Container.DisplayIndex %>' CssClass="admin-action" CausesValidation="false">Editar</asp:LinkButton><asp:LinkButton runat="server" CommandName="Restablecer" CommandArgument='<%# Container.DisplayIndex %>' CssClass="admin-action" CausesValidation="false" OnClientClick="return confirmarRestablecimientoUsuario(this);">Cambiar contraseña</asp:LinkButton><asp:LinkButton runat="server" ID="lnkEstado" CommandName="Estado" CommandArgument='<%# Container.DisplayIndex %>' CssClass='<%# If(CBool(Eval("Activo")), "admin-action danger", "admin-action") %>' CausesValidation="false"><%# If(CBool(Eval("Activo")), "Desactivar", "Reactivar") %></asp:LinkButton></div></ItemTemplate></asp:TemplateField></Columns></asp:GridView></div>
  </section>
 </asp:Panel>
  <asp:Panel ID="modalUsuario" runat="server" Visible="false" CssClass="admin-overlay" role="dialog" aria-modal="true" aria-labelledby="tituloModalUsuario" onclick="if(event.target === this){var cancelButton=document.getElementById('btnCancelar');if(cancelButton){cancelButton.click();}}">
 <section class="admin-dialog">
  <div class="admin-dialog-heading"><span id="adminUserAvatarInitials" class="admin-profile-avatar" aria-hidden="true">US</span><div><h2 id="tituloModalUsuario"><asp:Literal ID="litTituloModal" runat="server" Mode="Encode" /></h2><p class="admin-dialog-lead"><asp:Literal ID="litDialogLead" runat="server" Mode="Encode" /></p></div></div>
  <asp:HiddenField ID="hfUsuarioId" runat="server"/><asp:HiddenField ID="hfModoRestablecer" ClientIDMode="Static" runat="server"/>
  <asp:Panel ID="pnlDatosUsuario" runat="server">
   <div class="admin-dialog-grid"><div><label for="txtNombreCompleto">Nombre completo</label><asp:TextBox ID="txtNombreCompleto" runat="server" CssClass="form-control" MaxLength="160" required="required"/></div><div><label for="txtNombreUsuario">Nombre de usuario</label><asp:TextBox ID="txtNombreUsuario" runat="server" CssClass="form-control" MaxLength="20" minlength="3" required="required"/></div><div><label for="txtCorreo">Correo</label><asp:TextBox ID="txtCorreo" runat="server" CssClass="form-control" TextMode="Email" MaxLength="254" required="required"/></div><div><label for="ddlRol">Rol</label><asp:DropDownList ID="ddlRol" runat="server" CssClass="form-select" required="required"/></div><div><label for="txtClave">Contraseña inicial</label><asp:TextBox ID="txtClave" runat="server" CssClass="form-control" TextMode="Password" MaxLength="128" autocomplete="new-password"/><small class="admin-help">Al crear la cuenta es obligatoria. Se aplican las reglas de contraseña configuradas para el sistema.</small></div><div class="admin-account-state"><div class="admin-account-copy"><strong>Estado de la cuenta</strong><small>Define si el usuario puede iniciar sesión.</small></div><asp:CheckBox ID="chkActivo" runat="server" Text="Activa" Checked="true" CssClass="admin-account-check"/></div></div>
  </asp:Panel>
  <asp:Panel ID="pnlClaveManual" runat="server" Visible="false" CssClass="admin-manual-password">
   <div class="admin-manual-password-heading"><strong>Clave para <asp:Literal ID="litUsuarioClaveManual" runat="server" Mode="Encode" /></strong><span>Esta clave se solicitará cambiar al usuario en su próximo ingreso.</span></div>
   <div class="admin-dialog-grid"><div><label for="txtClaveManual">Nueva contraseña</label><asp:TextBox ID="txtClaveManual" runat="server" CssClass="form-control" TextMode="Password" MaxLength="128" autocomplete="new-password" required="required"/></div><div><label for="txtClaveManualConfirmacion">Confirmar contraseña</label><asp:TextBox ID="txtClaveManualConfirmacion" runat="server" CssClass="form-control" TextMode="Password" MaxLength="128" autocomplete="new-password" required="required"/></div></div>
   <small class="admin-help">Usa la política de seguridad configurada. La clave no se mostrará después de guardar.</small>
  </asp:Panel>
  <asp:Panel ID="pnlClaveGenerada" runat="server" Visible="false" CssClass="admin-generated-password">
   <strong>Contraseña temporal generada</strong><p>Compártela con el usuario de forma segura. Solo se muestra esta vez.</p>
   <div class="admin-generated-value"><code id="generatedPassword"><asp:Literal ID="litClaveGenerada" runat="server" Mode="Encode" /></code><button type="button" class="admin-copy-password" onclick="copiarClaveGenerada();">Copiar clave</button></div>
   <small id="adminCopyStatus" aria-live="polite">El usuario deberá cambiarla al iniciar sesión.</small>
  </asp:Panel>
  <asp:Panel ID="pnlModalAcciones" runat="server" CssClass="admin-form-actions"><asp:Button ID="btnCancelar" ClientIDMode="Static" runat="server" Text="Cancelar" CssClass="btn btn-light" CausesValidation="false"/><asp:Button ID="btnGuardar" runat="server" Text="Guardar usuario" CssClass="btn btn-primary"/></asp:Panel>
 </section>
</asp:Panel>
</div>
<div id="adminActionConfirm" class="admin-confirm-backdrop" hidden role="presentation" onclick="if(event.target===this)cerrarConfirmacionUsuario();">
 <section class="admin-confirm-dialog" role="alertdialog" aria-modal="true" aria-labelledby="adminConfirmTitle" aria-describedby="adminConfirmMessage">
  <div class="admin-confirm-heading"><span class="admin-confirm-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M10.3 3.9 2.7 17a2 2 0 0 0 1.7 3h15.2a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z"/><path d="M12 9v4m0 4h.01"/></svg></span><h2 id="adminConfirmTitle">Confirmar acción</h2></div>
  <p id="adminConfirmMessage"></p>
  <div class="admin-confirm-actions"><button type="button" class="btn btn-light" onclick="cerrarConfirmacionUsuario();">Cancelar</button><button type="button" id="adminConfirmManual" class="btn btn-light" hidden onclick="definirClaveManualUsuario();">Clave manual</button><button type="button" id="adminConfirmProceed" class="admin-confirm-submit" onclick="continuarAccionUsuario();">Confirmar</button></div>
 </section>
</div>
<script>
(function(){
 var accionPendiente=null,permitirAccion=false,overlay=document.getElementById('adminActionConfirm'),botonConfirmar=document.getElementById('adminConfirmProceed'),botonManual=document.getElementById('adminConfirmManual'),modo=document.getElementById('hfModoRestablecer');
 function mostrarConfirmacion(control,titulo,mensaje,accion,tono,opcionManual){
  if(permitirAccion){permitirAccion=false;return true;}
  accionPendiente=control;if(modo)modo.value='';document.getElementById('adminConfirmTitle').textContent=titulo;document.getElementById('adminConfirmMessage').textContent=mensaje;botonConfirmar.textContent=accion;botonConfirmar.className='admin-confirm-submit '+(tono||'');botonManual.hidden=!opcionManual;overlay.hidden=false;(opcionManual?botonManual:botonConfirmar).focus();return false;
 }
 window.confirmarAccionUsuario=function(control,titulo,mensaje,accion,tono){return mostrarConfirmacion(control,titulo,mensaje,accion,tono,false);};
 window.confirmarRestablecimientoUsuario=function(control){return mostrarConfirmacion(control,'Restablecer contraseña','Elige cómo quieres asignar la nueva clave. En ambos casos, el usuario deberá cambiarla en su próximo ingreso.','Generar clave','warning',true);};
 window.cerrarConfirmacionUsuario=function(){if(!overlay)return;overlay.hidden=true;if(accionPendiente){accionPendiente.focus();}accionPendiente=null;if(modo)modo.value='';};
 function enviarAccion(modoClave){if(!accionPendiente)return;if(modo)modo.value=modoClave;var control=accionPendiente;overlay.hidden=true;accionPendiente=null;permitirAccion=true;control.click();}
 window.continuarAccionUsuario=function(){enviarAccion('GENERADA');};
 window.definirClaveManualUsuario=function(){enviarAccion('MANUAL');};
 window.copiarClaveGenerada=function(){var texto=document.getElementById('generatedPassword').textContent,estado=document.getElementById('adminCopyStatus');if(navigator.clipboard&&window.isSecureContext){navigator.clipboard.writeText(texto).then(function(){estado.textContent='Clave copiada al portapapeles.';}).catch(function(){estado.textContent='No se pudo copiar; selecciona la clave y cópiala manualmente.';});return;}var campo=document.createElement('textarea');campo.value=texto;campo.style.position='fixed';campo.style.opacity='0';document.body.appendChild(campo);campo.select();try{document.execCommand('copy');estado.textContent='Clave copiada al portapapeles.';}catch(e){estado.textContent='No se pudo copiar; selecciona la clave y cópiala manualmente.';}campo.remove();};
 document.addEventListener('keydown',function(e){if(!overlay.hidden&&e.key==='Escape'){e.preventDefault();window.cerrarConfirmacionUsuario();}});
})();
</script>
<script>
(function(){
 var filtros=document.querySelectorAll('[data-admin-state-filter]');
 var estado=document.getElementById('<%= ddlEstadoFiltro.ClientID %>');
 var claveSeleccion='admin-usuarios-kpi-seleccion',cambioPorTarjeta=false;
 if(!estado||!filtros.length)return;
 function actualizar(){var guardado=sessionStorage.getItem(claveSeleccion);filtros.forEach(function(b){var seleccionado=!!guardado&&guardado===b.getAttribute('data-admin-state-filter')&&estado.value===guardado;b.classList.toggle('is-selected',seleccionado);b.setAttribute('aria-pressed',seleccionado?'true':'false');});}
 estado.addEventListener('change',function(){if(!cambioPorTarjeta)sessionStorage.removeItem(claveSeleccion);});
 filtros.forEach(function(b){b.addEventListener('click',function(){var valor=b.getAttribute('data-admin-state-filter');if(estado.value===valor&&sessionStorage.getItem(claveSeleccion)===valor){actualizar();return;}sessionStorage.setItem(claveSeleccion,valor);cambioPorTarjeta=true;estado.value=valor;estado.dispatchEvent(new Event('change',{bubbles:true}));});});
 actualizar();
})();
</script>
<script>
(function(){
 var field=document.getElementById('<%= txtNombreCompleto.ClientID %>'),avatar=document.getElementById('adminUserAvatarInitials');
 if(!field||!avatar)return;
 function actualizarIniciales(){var partes=field.value.trim().split(/\s+/).filter(Boolean);avatar.textContent=partes.length>1?(partes[0][0]+partes[partes.length-1][0]).toLocaleUpperCase('es-PA'):(partes[0]||'US').slice(0,2).toLocaleUpperCase('es-PA');}
 actualizarIniciales();field.addEventListener('input',actualizarIniciales);
})();
</script></asp:Content>
