e:12px}.admin-generated-password{padding:18px;border:1px solid #ccebd9;border-radius:16px;background:#eff9f3;color:#176a46}.admin-generated-password>strong{display:block;font-size:15px}.admin-generated-password>p{margin:5px 0 12px;color:#638573;font-size:12px}.admin-generated-value{display:flex;align-items:center;gap:10px;flex-wrap:wrap}.admin-generated-value code{flex:1;min-width:180px;padding:10px 12px;border-radius:10px;background:#fff;color:#c13b77;font-size:15px;letter-spacing:.03em;overflow-wrap:anywhere}.admin-copy-password{border:1px solid #b9dfca;border-radius:999px;padding:9px 14px;background:#fff;color:#087849;font-size:12px;font-weight:700}.admin-generated-password>small{display:block;margin-top:10px;color:#618373}.admin-confirm-actions #adminConfirmManual[hidden]{display:none!important}.admin-confirm-actions #adminConfirmManual{border-radius:999px;font-weight:650}
