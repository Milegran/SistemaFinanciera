<%@ Page Title="Estados y catálogos" Language="vb" AutoEventWireup="false" MasterPageFile="~/Site.Master" CodeBehind="Catalogos.aspx.vb" Inherits="SistemaFinanciera.CatalogosAdmin" %>
<asp:Content ID="Head" ContentPlaceHolderID="HeadContent" runat="server"><style>.catalog-page{max-width:1380px;margin:0 auto}.catalog-page h1{margin:0;color:#162235;font-size:36px;font-weight:750;letter-spacing:-1px}.catalog-page header p{margin:7px 0 22px;color:#8491a3}.catalog-controls{display:grid;grid-template-columns:minmax(240px,420px) auto;align-items:end;gap:14px}.catalog-controls label{display:block;margin-bottom:6px;color:#536276;font-size:12px;font-weight:650}.catalog-table{min-width:620px}.catalog-table th{font-size:10px;text-transform:uppercase;white-space:nowrap}.catalog-table td{vertical-align:middle}.catalog-active-check{width:18px;height:18px;accent-color:#0d7a48;cursor:pointer}.catalog-actions{display:flex;align-items:center;justify-content:space-between;gap:14px;margin-top:16px;padding-top:15px;border-top:1px solid #edf0f2}.catalog-actions small{color:#8491a3;font-size:12px}.catalog-readonly{color:#8491a3;font-size:12px}.catalog-chip{display:inline-flex;padding:5px 9px;border-radius:18px;background:#eaf6ef;color:#087849;font-size:11px;font-weight:650}.catalog-note{margin-top:15px;color:#8592a3;font-size:12px}@media(max-width:700px){.catalog-page h1{font-size:29px}.catalog-controls{grid-template-columns:1fr}}</style></asp:Content>
<asp:Content ID="Body" ContentPlaceHolderID="MainContent" runat="server"><div class="finance-page catalog-page"><div id="pnlMensaje" runat="server" class="alert" role="status" aria-live="polite"><asp:Literal ID="mensaje" runat="server" Mode="Encode"/></div><asp:Panel ID="contenidoAdmin" runat="server"><header><div class="eyebrow">CapitalWest / Administración</div><h1>Estados y catálogos</h1><p>Consulta los valores que utilizan los formularios y registros del sistema.</p></header><section class="cw-card"><div class="catalog-controls"><div><label for="ddlCatalogo">Catálogo</label><asp:DropDownList ID="ddlCatalogo" runat="server" CssClass="form-select" AutoPostBack="true"><asp:ListItem Text="Estados del préstamo" Value="ESTADOS"/><asp:ListItem Text="Estados civiles" Value="ESTADOS_CIVILES"/><asp:ListItem Text="Tipos de tasa" Value="TIPOS_TASA"/><asp:ListItem Text="Formas de pago" Value="FORMAS_PAGO"/><asp:ListItem Text="Periodicidades" Value="PERIODICIDADES"/><asp:ListItem Text="Provincias" Value="PROVINCIAS"/><asp:ListItem Text="Distritos" Value="DISTRITOS"/><asp:ListItem Text="Corregimientos" Value="CORREGIMIENTOS"/></asp:DropDownList></div><span class="catalog-chip"><asp:Literal ID="litTotal" runat="server" Mode="Encode"/></span></div><div class="table-responsive" style="margin-top:18px"><asp:GridView ID="grCatalogo" runat="server" AutoGenerateColumns="true" DataKeyNames="Codigo" OnRowDataBound="CatalogoRowDataBound" CssClass="table table-hover catalog-table" GridLines="None" EmptyDataText="No hay valores para mostrar."/></div><div class="catalog-actions"><small>Marca los valores que deben estar disponibles en los formularios.</small><asp:Button ID="btnGuardarEstados" runat="server" Text="Guardar estados" CssClass="btn btn-primary" CausesValidation="false"/></div><p class="catalog-note">Los estados base y catálogos geográficos se consultan aquí para mantener consistencia con los registros existentes. La edición de listas maestras está protegida hasta definir sus reglas de transición y dependencias.</p></section></asp:Panel></div></asp:Content>
