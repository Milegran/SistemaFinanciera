<%@ Page Title="Cambiar contraseña" Language="vb" AutoEventWireup="false" MasterPageFile="~/Site.Master" CodeBehind="CambiarClave.aspx.vb" Inherits="SistemaFinanciera.CambiarClave" %>
<asp:Content ID="Head" ContentPlaceHolderID="HeadContent" runat="server"><style>.change-password-wrap{max-width:700px;margin:40px auto}.change-password-card{padding:clamp(24px,5vw,42px);border:1px solid #e4e9ed;border-radius:26px;background:#fff;box-shadow:0 18px 45px #2033480c}.change-password-icon{display:grid;place-items:center;width:52px;height:52px;margin-bottom:18px;border-radius:17px;background:#e7f5ee;color:#087849}.change-password-icon svg{width:25px;height:25px}.change-password-card h1{margin:0;color:#172538;font-size:27px;font-weight:700}.change-password-card p{margin:9px 0 22px;color:#8491a3}.change-password-fields{display:grid;gap:15px}.change-password-card .btn{margin-top:20px}</style></asp:Content>
<asp:Content ID="Body" ContentPlaceHolderID="MainContent" runat="server"><div class="finance-page change-password-wrap"><div id="pnlMensaje" runat="server" class="alert" role="status" aria-live="polite"><asp:Literal ID="mensaje" runat="server" Mode="Encode"/></div><section class="change-password-card"><div class="change-password-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 1 1 8 0v3m-4 4v3"/></svg></div><div class="eyebrow">SEGURIDAD DE LA CUENTA</div><h1>Crea una contraseña nueva</h1><p>Por seguridad debes cambiar tu contraseña temporal antes de usar el sistema.</p><div class="change-password-fields"><div><label for="txtNueva">Nueva contraseña</label><asp:TextBox ID="txtNueva" runat="server" CssClass="form-control" TextMode="Password" MaxLength="128" minlength="12" autocomplete="new-password" required="required"/><small class="admin-help">12 caracteres o más; incluye mayúscula, minúscula y número.</small></div><div><label for="txtConfirmar">Confirmar contraseña</label><asp:TextBox ID="txtConfirmar" runat="server" CssClass="form-control" TextMode="Password" MaxLength="128" minlength="12" autocomplete="new-password" required="required"/></div></div><asp:Button ID="btnCambiar" runat="server" Text="Guardar contraseña y continuar" CssClass="btn btn-primary"/></section></div></asp:Content>
