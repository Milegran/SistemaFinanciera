<%@ Page Title="Auditoría del sistema" Language="vb" AutoEventWireup="false" MasterPageFile="~/Site.Master" CodeBehind="Auditoria.aspx.vb" Inherits="SistemaFinanciera.Auditoria" %>
<asp:Content ID="Head" ContentPlaceHolderID="HeadContent" runat="server"><style>
.audit-page{max-width:1500px;margin:0 auto}.audit-heading{margin-bottom:22px}.audit-heading h1{margin:0;color:#162235;font-size:36px;font-weight:750;letter-spacing:-1px}.audit-heading p{margin:7px 0 0;color:#8491a3}.audit-filters{display:grid;grid-template-columns:1.5fr 1fr 1fr 1fr 1fr auto;align-items:end;gap:12px}.audit-filters label{display:block;margin-bottom:6px;font-size:11px;font-weight:650}.audit-toolbar{display:flex;align-items:center;justify-content:space-between;gap:14px;margin:19px 0 13px}.audit-toolbar p{margin:0;color:#8190a2;font-size:12px}.audit-table{min-width:1050px}.audit-table th{font-size:10px;letter-spacing:.04em;text-transform:uppercase;white-space:nowrap}.audit-table td{vertical-align:middle}.audit-tag{display:inline-flex;padding:5px 9px;border-radius:20px;background:#eaf6ef;color:#087849;font-size:10px;font-weight:700}.audit-detail-button{border:0;border-radius:9px;background:#f2f6f4;color:#087849;padding:7px 10px;font-size:11px;font-weight:650}.audit-detail-button:hover{background:#dff2e8}.audit-dialog{position:fixed;inset:0;z-index:1100;display:grid;place-items:center;padding:20px;background:#18263872;backdrop-filter:blur(3px)}.audit-dialog-card{width:min(100%,760px);max-height:88vh;overflow:auto;padding:25px;border:1px solid #e6ebef;border-radius:23px;background:#fff;box-shadow:0 25px 80px #17253830}.audit-dialog-actions{display:flex;justify-content:flex-end;margin-top:18px;padding-top:16px;border-top:1px solid #edf0f2}.audit-detail-grid{display:grid;grid-template-columns:1fr 1fr;gap:13px;margin-top:18px}.audit-detail-field{padding:14px;border:1px solid #ebeff2;border-radius:14px;background:#fbfcfc}.audit-detail-field small{display:block;margin-bottom:7px;color:#8390a1;font-size:10px;font-weight:700;letter-spacing:.05em;text-transform:uppercase}.audit-detail-field div{color:#26364a;font-size:12px;overflow-wrap:anywhere;white-space:pre-wrap}.audit-detail-field.wide{grid-column:1/-1}.audit-export{display:flex;gap:9px}@media(max-width:1100px){.audit-filters{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:650px){.audit-heading h1{font-size:29px}.audit-filters{grid-template-columns:1fr 1fr}.audit-detail-grid{grid-template-columns:1fr}.audit-detail-field.wide{grid-column:auto}}
</style></asp:Content>
<asp:Content ID="Body" ContentPlaceHolderID="MainContent" runat="server"><div class="finance-page audit-page"><div id="pnlMensaje" runat="server" class="alert" role="status" aria-live="polite"><asp:Literal ID="mensaje" runat="server" Mode="Encode"/></div><asp:Panel ID="contenidoAdmin" runat="server"><header class="audit-heading"><div class="eyebrow">CapitalWest / Administración</div><h1>Auditoría del sistema</h1><p>Consulta las operaciones registradas. Esta bitácora es de solo lectura.</p></header><section class="cw-card" aria-label="Filtros de auditoría"><div class="audit-filters"><div><label for="ddlUsuario">Usuario</label><asp:DropDownList ID="ddlUsuario" runat="server" CssClass="form-select"/></div><div><label for="ddlModulo">Módulo</label><asp:DropDownList ID="ddlModulo" runat="server" CssClass="form-select"><asp:ListItem Text="Todos los módulos" Value=""/><asp:ListItem Text="SEGURIDAD" Value="SEGURIDAD"/><asp:ListItem Text="METODOS" Value="METODOS"/><asp:ListItem Text="FINANZAS" Value="FINANZAS"/><asp:ListItem Text="CLIENTES" Value="CLIENTES"/><asp:ListItem Text="PRODUCTOS" Value="PRODUCTOS"/><asp:ListItem Text="SOLICITUDES" Value="SOLICITUDES"/><asp:ListItem Text="PRÉSTAMOS" Value="PRÉSTAMOS"/><asp:ListItem Text="PAGOS" Value="PAGOS"/><asp:ListItem Text="REPORTES" Value="REPORTES"/></asp:DropDownList></div><div><label for="ddlAccion">Acción</label><asp:DropDownList ID="ddlAccion" runat="server" CssClass="form-select"><asp:ListItem Text="Todas las acciones" Value=""/><asp:ListItem Text="Inicio de sesión" Value="INICIO_SESION"/><asp:ListItem Text="Intento fallido" Value="INTENTO_FALLIDO"/><asp:ListItem Text="Bloqueo temporal" Value="BLOQUEO_TEMPORAL"/><asp:ListItem Text="Creación" Value="CREAR"/><asp:ListItem Text="Actualización" Value="ACTUALIZAR"/><asp:ListItem Text="Usuario creado" Value="USUARIO_CREADO"/><asp:ListItem Text="Usuario actualizado" Value="USUARIO_ACTUALIZADO"/><asp:ListItem Text="Clave restablecida" Value="CLAVE_RESTAURADA"/><asp:ListItem Text="Clave cambiada" Value="CLAVE_CAMBIADA"/><asp:ListItem Text="Usuario activado" Value="USUARIO_ACTIVADO"/><asp:ListItem Text="Usuario desactivado" Value="USUARIO_DESACTIVADO"/><asp:ListItem Text="Parámetro actualizado" Value="PARAMETRO_ACTUALIZADO"/><asp:ListItem Text="Método activado" Value="METODO_ACTIVADO"/><asp:ListItem Text="Método desactivado" Value="METODO_DESACTIVADO"/></asp:DropDownList></div><div><label for="txtDesde">Desde</label><asp:TextBox ID="txtDesde" runat="server" CssClass="form-control" TextMode="Date"/></div><div><label for="txtHasta">Hasta</label><asp:TextBox ID="txtHasta" runat="server" CssClass="form-control" TextMode="Date"/></div><asp:Button ID="btnFiltrar" runat="server" Text="Filtrar" CssClass="btn btn-primary"/></div></section><section class="cw-card" style="margin-top:18px"><div class="audit-toolbar"><p><asp:Literal ID="litConteo" runat="server" Mode="Encode"/></p><div class="audit-export"><asp:Button ID="btnLimpiar" runat="server" Text="Limpiar" CssClass="btn btn-light" CausesValidation="false"/><asp:Button ID="btnExportar" runat="server" Text="Exportar CSV" CssClass="btn btn-outline-primary" CausesValidation="false"/></div></div><div class="table-responsive"><asp:GridView ID="grAuditoria" runat="server" AutoGenerateColumns="false" DataKeyNames="Id" AllowPaging="true" PageSize="50" OnPageIndexChanging="PaginarAuditoria" CssClass="table table-hover audit-table" GridLines="None" EmptyDataText="No hay operaciones para estos filtros."><Columns><asp:BoundField DataField="Fecha" HeaderText="Fecha y hora"/><asp:BoundField DataField="Usuario" HeaderText="Usuario" NullDisplayText="Sistema"/><asp:BoundField DataField="Rol" HeaderText="Rol"/><asp:BoundField DataField="Modulo" HeaderText="Módulo"/><asp:TemplateField HeaderText="Acción"><ItemTemplate><span class="audit-tag"><%#: Eval("Accion") %></span></ItemTemplate></asp:TemplateField><asp:BoundField DataField="Descripcion" HeaderText="Descripción"/><asp:TemplateField HeaderText="Referencia"><ItemTemplate><asp:LinkButton ID="lnkDetalle" runat="server" CommandName="Detalle" CommandArgument='<%# Container.DisplayIndex %>' CssClass="audit-detail-button" CausesValidation="false">Ver detalle</asp:LinkButton></ItemTemplate></asp:TemplateField></Columns></asp:GridView></div></section></asp:Panel><asp:Panel ID="modalDetalle" runat="server" Visible="false" CssClass="audit-dialog" role="dialog" aria-modal="true" aria-labelledby="tituloDetalle"><section class="audit-dialog-card"><div class="admin-section-title"><div><div class="eyebrow">REGISTRO DE ACTIVIDAD</div><h2 id="tituloDetalle">Detalle de auditoría</h2></div></div><div class="audit-detail-grid"><div class="audit-detail-field"><small>Fecha y hora</small><div><asp:Literal ID="litFecha" runat="server" Mode="Encode"/></div></div><div class="audit-detail-field"><small>Usuario / rol</small><div><asp:Literal ID="litUsuario" runat="server" Mode="Encode"/></div></div><div class="audit-detail-field"><small>Módulo y acción</small><div><asp:Literal ID="litAccion" runat="server" Mode="Encode"/></div></div><div class="audit-detail-field"><small>Referencia</small><div><asp:Literal ID="litReferencia" runat="server" Mode="Encode"/></div></div><div class="audit-detail-field wide"><small>Descripción</small><div><asp:Literal ID="litDescripcion" runat="server" Mode="Encode"/></div></div><div class="audit-detail-field"><small>Valor anterior</small><div><asp:Literal ID="litAnterior" runat="server" Mode="Encode"/></div></div><div class="audit-detail-field"><small>Valor nuevo</small><div><asp:Literal ID="litNuevo" runat="server" Mode="Encode"/></div></div><div class="audit-detail-field wide"><small>Dirección IP</small><div><asp:Literal ID="litIp" runat="server" Mode="Encode"/></div></div></div><div class="audit-dialog-actions"><asp:Button ID="btnCerrarDetalle" runat="server" Text="Cerrar" CssClass="btn btn-primary" CausesValidation="false"/></div></section></asp:Panel></div></asp:Content>