<%@ Page Title="Pagos" Language="VB" AutoEventWireup="false" MasterPageFile="~/Site.Master" CodeBehind="Pagos.aspx.vb" Inherits="SistemaFinanciera.Pagos" %>
<asp:Content ID="Body" ContentPlaceHolderID="MainContent" runat="server"><div class="finance-page"><div class="page-header"><div><h1>Pagos</h1><p>CapitalWest · Gestión financiera</p></div><a href="<%= ResolveUrl("~/Acceso.aspx") %>" class="btn btn-light">Acceso</a></div><div id="pnlMensaje" runat="server" class="alert" role="status" aria-live="polite"><asp:Literal ID="mensaje" runat="server" Mode="Encode" /></div><asp:Panel ID="registro" runat="server" data-finanzas-form="pago" CssClass="cw-card"><h2>Registrar pago</h2><p>Solo cuotas exigibles a hoy. Se admiten pagos parciales; aplicación por cuota más antigua: mora → cargos → interés → capital. No se admiten sobrepagos ni abonos anticipados en este flujo.</p><div class="finance-fields"><div class="finance-field"><label for="<%= prestamo.ClientID %>">Préstamo</label><asp:DropDownList ID="prestamo" runat="server" required="required" CssClass="form-select" AutoPostBack="true" /></div><div class="finance-field"><label for="<%= fechaPago.ClientID %>">Fecha operativa de Panamá</label><asp:TextBox ID="fechaPago" runat="server" CssClass="form-control" TextMode="Date" ReadOnly="true" /></div><div class="finance-field"><label for="<%= monto.ClientID %>">Monto recibido (B/.)</label><asp:TextBox ID="monto" runat="server" CssClass="form-control" TextMode="Number" min="0.01" max="999999999999.99" step="0.01" required="required" /></div><div class="finance-field"><label for="<%= forma.ClientID %>">Forma de pago</label><asp:DropDownList ID="forma" runat="server" required="required" CssClass="form-select"  /></div><div class="finance-field"><label for="<%= referencia.ClientID %>">Referencia (obligatoria salvo efectivo)</label><asp:TextBox ID="referencia" runat="server" CssClass="form-control"  MaxLength="100" /></div></div><asp:Literal ID="saldo" runat="server" Mode="Encode" /><div class="finance-actions"><asp:Button ID="guardar" runat="server" formnovalidate="formnovalidate" data-validar-finanzas="pago" Text="Registrar pago" CssClass="btn btn-primary" OnClientClick="return confirm('¿Confirma el pago y el préstamo seleccionado?');" /></div></asp:Panel><section class="cw-card"><h2>Cuotas del préstamo seleccionado</h2><div class="table-responsive"><asp:GridView ID="cuotas" runat="server" AutoGenerateColumns="false" DataKeyNames="Id" CssClass="table" GridLines="None" EmptyDataText="No hay registros."><Columns><asp:BoundField DataField="NumeroCuota" HeaderText="N.º" /><asp:BoundField DataField="FechaVencimiento" HeaderText="Vencimiento" DataFormatString="{0:dd/MM/yyyy}" /><asp:BoundField DataField="CapitalPendiente" HeaderText="Capital" DataFormatString="{0:N2}" /><asp:BoundField DataField="InteresPendiente" HeaderText="Interés" DataFormatString="{0:N2}" /><asp:BoundField DataField="TotalPendiente" HeaderText="Total pendiente" DataFormatString="{0:N2}" /><asp:BoundField DataField="EstadoCuota" HeaderText="Estado" /></Columns></asp:GridView></div></section><section class="cw-card"><h2>Recibos</h2><div class="table-responsive"><asp:GridView ID="listado" runat="server" AutoGenerateColumns="false" DataKeyNames="Id" CssClass="table" GridLines="None" EmptyDataText="No hay registros."><Columns><asp:BoundField DataField="NumeroRecibo" HeaderText="Recibo" /><asp:BoundField DataField="NumeroPrestamo" HeaderText="Préstamo" /><asp:BoundField DataField="Cliente" HeaderText="Cliente" /><asp:BoundField DataField="FechaPago" HeaderText="Fecha" DataFormatString="{0:dd/MM/yyyy}" /><asp:BoundField DataField="MontoPagado" HeaderText="Importe" DataFormatString="{0:N2}" /><asp:BoundField DataField="Capital" HeaderText="Capital" DataFormatString="{0:N2}" /><asp:BoundField DataField="Interes" HeaderText="Interés" DataFormatString="{0:N2}" /><asp:BoundField DataField="Mora" HeaderText="Mora" DataFormatString="{0:N2}" /><asp:BoundField DataField="OtrosCargos" HeaderText="Cargos" DataFormatString="{0:N2}" /><asp:BoundField DataField="SaldoCapitalPosterior" HeaderText="Saldo capital" DataFormatString="{0:N2}" /><asp:BoundField DataField="Usuario" HeaderText="Registrado por" /></Columns></asp:GridView></div></section></div></asp:Content>