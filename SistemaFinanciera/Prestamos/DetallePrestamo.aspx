<%@ Page Title="Detalle del préstamo" Language="VB" AutoEventWireup="false" MasterPageFile="~/Site.Master" CodeBehind="DetallePrestamo.aspx.vb" Inherits="SistemaFinanciera.DetallePrestamo" %>
<asp:Content ID="Body" ContentPlaceHolderID="MainContent" runat="server"><div class="finance-page"><div class="page-header"><div><h1>Detalle del préstamo</h1><p>CapitalWest · Gestión financiera</p></div><a href="<%= ResolveUrl("~/Acceso.aspx") %>" class="btn btn-light">Acceso</a></div><div id="pnlMensaje" runat="server" class="alert" role="status" aria-live="polite"><asp:Literal ID="mensaje" runat="server" Mode="Encode" /></div><section class="cw-card"><h2>Contrato</h2><asp:Literal ID="resumen" runat="server" Mode="Encode" /><div class="finance-actions"><a class="btn btn-light" href="Prestamos.aspx">Volver a cartera</a><a class="btn btn-primary" href="<%= ResolveUrl("~/Pagos/Pagos.aspx") %>">Registrar pago</a></div></section><section class="cw-card"><h2>Tabla de amortización y saldos</h2><div class="table-responsive"><asp:GridView ID="cuotas" runat="server" AutoGenerateColumns="false" DataKeyNames="Id" CssClass="table" GridLines="None" EmptyDataText="No hay registros."><Columns><asp:BoundField DataField="NumeroCuota" HeaderText="N.º" /><asp:BoundField DataField="FechaVencimiento" HeaderText="Vencimiento" DataFormatString="{0:dd/MM/yyyy}" /><asp:BoundField DataField="Capital" HeaderText="Capital" DataFormatString="{0:N2}" /><asp:BoundField DataField="Interes" HeaderText="Interés" DataFormatString="{0:N2}" /><asp:BoundField DataField="Mora" HeaderText="Mora" DataFormatString="{0:N2}" /><asp:BoundField DataField="TotalPendiente" HeaderText="Total pendiente" DataFormatString="{0:N2}" /><asp:BoundField DataField="EstadoCuota" HeaderText="Estado" /></Columns></asp:GridView></div></section><section class="cw-card"><h2>Movimientos contabilizados</h2><p>El interés contractual se reconoce al entrar la cuota en cobro. Los intereses futuros del calendario no son deuda exigible.</p><div class="table-responsive"><asp:GridView ID="movimientos" runat="server" AutoGenerateColumns="false" CssClass="table"><Columns><asp:BoundField DataField="Fecha" HeaderText="Fecha" DataFormatString="{0:dd/MM/yyyy HH:mm}" /><asp:BoundField DataField="Tipo" HeaderText="Operación" /><asp:BoundField DataField="Concepto" HeaderText="Concepto" /><asp:BoundField DataField="Debito" HeaderText="Débito" DataFormatString="{0:N2}" /><asp:BoundField DataField="Credito" HeaderText="Crédito" DataFormatString="{0:N2}" /><asp:BoundField DataField="SaldoAcumulado" HeaderText="Saldo" DataFormatString="{0:N2}" /></Columns></asp:GridView></div></section></div></asp:Content>