<%@ Master Language="VB" AutoEventWireup="true" CodeBehind="Site.master.vb" Inherits="SistemaFinanciera.SiteMaster" %>
<!DOCTYPE html><html lang="es"><head runat="server">
<meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
<title><%: Page.Title %> | CapitalWest</title>
<webopt:bundlereference runat="server" path="~/Content/css" />
<link rel="stylesheet" href="<%= ResolveUrl("~/Content/Financiera.css") %>" />
<link rel="stylesheet" href="<%= ResolveUrl("~/Content/Stitch.css") %>" />
<asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head><body class="<%= If(Request.AppRelativeCurrentExecutionFilePath.ToLowerInvariant().Contains("/clientes/"), "stitch-clients", "stitch-dashboard") %>"><form id="form1" runat="server"><div class="stitch-shell">
<asp:ScriptManager runat="server">
            <Scripts>
                <asp:ScriptReference Name="MsAjaxBundle" />
                <asp:ScriptReference Name="jquery" />
                <asp:ScriptReference Name="WebForms.js" Assembly="System.Web"
                    Path="~/Scripts/WebForms/WebForms.js" />
                <asp:ScriptReference Name="WebUIValidation.js" Assembly="System.Web"
                    Path="~/Scripts/WebForms/WebUIValidation.js" />
                <asp:ScriptReference Name="MenuStandards.js" Assembly="System.Web"
                    Path="~/Scripts/WebForms/MenuStandards.js" />
                <asp:ScriptReference Name="GridView.js" Assembly="System.Web"
                    Path="~/Scripts/WebForms/GridView.js" />
                <asp:ScriptReference Name="DetailsView.js" Assembly="System.Web"
                    Path="~/Scripts/WebForms/DetailsView.js" />
                <asp:ScriptReference Name="TreeView.js" Assembly="System.Web"
                    Path="~/Scripts/WebForms/TreeView.js" />
                <asp:ScriptReference Name="WebParts.js" Assembly="System.Web"
                    Path="~/Scripts/WebForms/WebParts.js" />
                <asp:ScriptReference Name="Focus.js" Assembly="System.Web"
                    Path="~/Scripts/WebForms/Focus.js" />
                <asp:ScriptReference Name="WebFormsBundle" />
            </Scripts>
        </asp:ScriptManager>
<header class="cw-topbar">
    <a class="cw-brand" href="<%= ResolveUrl("~/Default.aspx") %>" aria-label="CapitalWest, inicio"><span class="cw-brand-mark"><img src="<%= ResolveUrl("~/Content/Images/capitalwest.png") %>" alt="" /></span><span>Capital<span class="brand-west">West</span></span><small>PRO</small></a>
    <nav class="cw-topnav" aria-label="Navegación principal"><a class="top-link" data-page="Default.aspx" href="<%= ResolveUrl("~/Default.aspx") %>" title="Inicio" aria-label="Inicio"><span>Inicio</span></a><a class="top-link" data-page="Clientes/Clientes.aspx" href="<%= ResolveUrl("~/Clientes/Clientes.aspx") %>" title="Clientes" aria-label="Clientes"><span>Clientes</span></a><a class="top-link" data-page="Productos/Productos.aspx" href="<%= ResolveUrl("~/Productos/Productos.aspx") %>" title="Productos" aria-label="Productos"><span>Productos</span></a><a class="top-link" data-page="Solicitudes/Solicitudes.aspx" href="<%= ResolveUrl("~/Solicitudes/Solicitudes.aspx") %>" title="Solicitudes" aria-label="Solicitudes"><span>Solicitudes</span></a><a class="top-link" data-page="Prestamos/Prestamos.aspx" href="<%= ResolveUrl("~/Prestamos/Prestamos.aspx") %>" title="Préstamos" aria-label="Préstamos"><span>Préstamos</span></a><a class="top-link" data-page="Pagos/Pagos.aspx" href="<%= ResolveUrl("~/Pagos/Pagos.aspx") %>" title="Pagos" aria-label="Pagos"><span>Pagos</span></a><a class="top-link" data-page="Reportes/Reportes.aspx" href="<%= ResolveUrl("~/Reportes/Reportes.aspx") %>" title="Reportes" aria-label="Reportes"><span>Reportes</span></a><a class="top-link" data-page="Administracion/Usuarios.aspx" href="<%= ResolveUrl("~/Administracion/Usuarios.aspx") %>" title="Administración" aria-label="Administración"><span>Administración</span></a></nav>
    <div class="cw-profile"><span class="profile-avatar">CW</span><span><strong>CapitalWest</strong><small>Gestión financiera</small></span></div>
    <button class="cw-menu-toggle" type="button" id="mobileMenu" aria-label="Abrir navegación" aria-controls="sidebar" aria-expanded="false"><svg class="cw-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg></button>
</header>
<button type="button" id="menuBackdrop" class="menu-backdrop" aria-label="Cerrar navegación" hidden></button>
<aside class="cw-rail" id="sidebar"><nav aria-label="Todos los módulos"><a class="rail-link" data-page="Default.aspx" href="<%= ResolveUrl("~/Default.aspx") %>" title="Inicio" aria-label="Inicio"><svg class="cw-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="2"/><rect x="14" y="3" width="7" height="7" rx="2"/><rect x="3" y="14" width="7" height="7" rx="2"/><rect x="14" y="14" width="7" height="7" rx="2"/></svg><span>Inicio</span></a><a class="rail-link" data-page="Clientes/Clientes.aspx" href="<%= ResolveUrl("~/Clientes/Clientes.aspx") %>" title="Clientes" aria-label="Clientes"><svg class="cw-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="3"/><path d="M3 21v-3a6 6 0 0 1 12 0v3M16 5a3 3 0 0 1 0 6M18 15a5 5 0 0 1 3 5"/></svg><span>Clientes</span></a><a class="rail-link" data-page="Productos/Productos.aspx" href="<%= ResolveUrl("~/Productos/Productos.aspx") %>" title="Productos" aria-label="Productos"><svg class="cw-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="15" rx="3"/><path d="M3 8V5l14-3v3M21 11h-6v5h6"/><path d="M17 13.5h.01"/></svg><span>Productos</span></a><a class="rail-link" data-page="Solicitudes/Solicitudes.aspx" href="<%= ResolveUrl("~/Solicitudes/Solicitudes.aspx") %>" title="Solicitudes" aria-label="Solicitudes"><svg class="cw-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9zM14 3v6h6M8 13h8M8 17h5"/></svg><span>Solicitudes</span></a><a class="rail-link" data-page="Prestamos/Prestamos.aspx" href="<%= ResolveUrl("~/Prestamos/Prestamos.aspx") %>" title="Préstamos" aria-label="Préstamos"><svg class="cw-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="3"/><circle cx="12" cy="12" r="3"/><path d="M6 12h.01M18 12h.01"/></svg><span>Préstamos</span></a><a class="rail-link" data-page="Pagos/Pagos.aspx" href="<%= ResolveUrl("~/Pagos/Pagos.aspx") %>" title="Pagos" aria-label="Pagos"><svg class="cw-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="15" rx="3"/><path d="M3 8V5l14-3v3M21 11h-6v5h6"/><path d="M17 13.5h.01"/></svg><span>Pagos</span></a><a class="rail-link" data-page="Simulador/Simulador.aspx" href="<%= ResolveUrl("~/Simulador/Simulador.aspx") %>" title="Simulador" aria-label="Simulador"><svg class="cw-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="2" width="14" height="20" rx="3"/><path d="M8 6h8M8 11h1M15 11h1M8 15h1M15 15h1M8 19h1M15 19h1"/></svg><span>Simulador</span></a><a class="rail-link" data-page="EstadosCuenta/EstadosCuenta.aspx" href="<%= ResolveUrl("~/EstadosCuenta/EstadosCuenta.aspx") %>" title="Estados de cuenta" aria-label="Estados de cuenta"><svg class="cw-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9zM14 3v6h6M8 13h8M8 17h5"/></svg><span>Estados de cuenta</span></a><a class="rail-link" data-page="Reportes/Reportes.aspx" href="<%= ResolveUrl("~/Reportes/Reportes.aspx") %>" title="Reportes" aria-label="Reportes"><svg class="cw-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 3v18h17M8 16v-5M13 16V7M18 16V4"/></svg><span>Reportes</span></a><a class="rail-link" data-page="Administracion/Usuarios.aspx" href="<%= ResolveUrl("~/Administracion/Usuarios.aspx") %>" title="Usuarios" aria-label="Usuarios"><svg class="cw-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="3"/><path d="M3 21v-3a6 6 0 0 1 12 0v3M16 5a3 3 0 0 1 0 6M18 15a5 5 0 0 1 3 5"/></svg><span>Usuarios</span></a><a class="rail-link" data-page="Administracion/Auditoria.aspx" href="<%= ResolveUrl("~/Administracion/Auditoria.aspx") %>" title="Auditoría" aria-label="Auditoría"><svg class="cw-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11a9 9 0 1 1 2 7M3 4v7h7M12 7v5l3 2"/></svg><span>Auditoría</span></a></nav><div class="rail-bottom"><span class="rail-status" title="CapitalWest" aria-label="CapitalWest"></span></div></aside>
<div class="cw-main"><main class="page-content" id="mainContent"><asp:ContentPlaceHolder ID="MainContent" runat="server" /></main>
<footer class="cw-footer"><span>CapitalWest <span class="footer-dot">·</span> Sistema de gestión financiera</span><span>Moneda Balboas (B/.) <span class="footer-dot">·</span> Panamá</span></footer></div>
<script src="<%= ResolveUrl("~/Scripts/CapitalWest.js?v=stitch2") %>"></script>
</div></form></body></html>

