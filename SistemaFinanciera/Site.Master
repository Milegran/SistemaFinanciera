<%@ Master Language="VB" AutoEventWireup="true" CodeBehind="Site.master.vb" Inherits="SistemaFinanciera.SiteMaster" %>

<!DOCTYPE html>

<html lang="es">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title><%: Page.Title %> - Sistema Financiero</title>

    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/bundles/modernizr") %>
    </asp:PlaceHolder>

    <webopt:bundlereference runat="server" path="~/Content/css" />

    <!-- Iconos -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.42.0/dist/tabler-icons.min.css" />

    <!-- Estilos propios -->
    <link href="<%= ResolveUrl("~/Content/Financiera.css") %>" rel="stylesheet" />

    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />

    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>

<body>

    <form id="form1" runat="server">

        <asp:ScriptManager runat="server">
            <Scripts>
                <asp:ScriptReference Name="MsAjaxBundle" />
                <asp:ScriptReference Name="jquery" />
                <asp:ScriptReference Name="WebForms.js" Assembly="System.Web"
                    Path="~/Scripts/WebForms/WebForms.js" />
                <asp:ScriptReference Name="WebUIValidation.js" Assembly="System.Web"
                    Path="~/Scripts/WebForms/WebUIValidation.js" />
                <asp:ScriptReference Name="MenuStandards.js" Assembly="System.Web"
                    Path="~/Scripts/WebForms/MenuStandards.js" />
                <asp:ScriptReference Name="GridView.js" Assembly="System.Web"
                    Path="~/Scripts/WebForms/GridView.js" />
                <asp:ScriptReference Name="DetailsView.js" Assembly="System.Web"
                    Path="~/Scripts/WebForms/DetailsView.js" />
                <asp:ScriptReference Name="TreeView.js" Assembly="System.Web"
                    Path="~/Scripts/WebForms/TreeView.js" />
                <asp:ScriptReference Name="WebParts.js" Assembly="System.Web"
                    Path="~/Scripts/WebForms/WebParts.js" />
                <asp:ScriptReference Name="Focus.js" Assembly="System.Web"
                    Path="~/Scripts/WebForms/Focus.js" />
                <asp:ScriptReference Name="WebFormsBundle" />
            </Scripts>
        </asp:ScriptManager>


        <!-- =========================
             MENÚ LATERAL
             ========================= -->
        <aside class="sidebar" id="sidebar">

            <!-- Logo -->
            <div class="sidebar-header">

                <div class="brand">
                    <div class="brand-icon">
                        <i class="ti ti-building-bank"></i>
                    </div>

                    <div class="brand-text">
                        <span class="brand-name">Financiera</span>
                        <span class="brand-subtitle">Sistema de Gestión</span>
                    </div>
                </div>

                <button type="button"
                        class="sidebar-toggle"
                        id="sidebarToggle"
                        title="Contraer menú">

                    <i class="ti ti-chevrons-left"></i>

                </button>

            </div>


            <!-- Navegación -->
            <nav class="sidebar-nav">

                <a href="<%= ResolveUrl("~/Default.aspx") %>"
                   class="nav-link">
                    <i class="ti ti-layout-dashboard"></i>
                    <span>Dashboard</span>
                </a>


                <div class="nav-section">
                    <span>GESTIÓN</span>
                </div>


                <a href="<%= ResolveUrl("~/Clientes/Clientes.aspx") %>"
                   class="nav-link">
                    <i class="ti ti-users"></i>
                    <span>Clientes</span>
                </a>


                <a href="<%= ResolveUrl("~/Productos/Productos.aspx") %>"
                   class="nav-link">
                    <i class="ti ti-wallet"></i>
                    <span>Productos financieros</span>
                </a>


                <a href="<%= ResolveUrl("~/Solicitudes/Solicitudes.aspx") %>"
                   class="nav-link">
                    <i class="ti ti-file-description"></i>
                    <span>Solicitudes</span>
                </a>


                <a href="<%= ResolveUrl("~/Prestamos/Prestamos.aspx") %>"
                   class="nav-link">
                    <i class="ti ti-cash-banknote"></i>
                    <span>Préstamos</span>
                </a>


                <a href="<%= ResolveUrl("~/Pagos/Pagos.aspx") %>"
                   class="nav-link">
                    <i class="ti ti-receipt"></i>
                    <span>Pagos</span>
                </a>


                <div class="nav-section">
                    <span>HERRAMIENTAS</span>
                </div>


                <a href="<%= ResolveUrl("~/Simulador/Simulador.aspx") %>"
                   class="nav-link">
                    <i class="ti ti-calculator"></i>
                    <span>Simulador</span>
                </a>


                <a href="<%= ResolveUrl("~/EstadosCuenta/EstadosCuenta.aspx") %>"
                   class="nav-link">
                    <i class="ti ti-file-invoice"></i>
                    <span>Estados de cuenta</span>
                </a>


                <a href="<%= ResolveUrl("~/Reportes/Reportes.aspx") %>"
                   class="nav-link">
                    <i class="ti ti-chart-bar"></i>
                    <span>Reportes</span>
                </a>


                <div class="nav-section">
                    <span>ADMINISTRACIÓN</span>
                </div>


                <a href="<%= ResolveUrl("~/Administracion/Usuarios.aspx") %>"
                   class="nav-link">
                    <i class="ti ti-user-cog"></i>
                    <span>Usuarios</span>
                </a>


                <a href="<%= ResolveUrl("~/Administracion/Auditoria.aspx") %>"
                   class="nav-link">
                    <i class="ti ti-history"></i>
                    <span>Auditoría</span>
                </a>

            </nav>


            <!-- Usuario -->
            <div class="sidebar-footer">

                <div class="user-info">

                    <div class="user-avatar">
                        AD
                    </div>

                    <div class="user-details">
                        <strong>Administrador</strong>
                        <span>Administrador</span>
                    </div>

                    <button type="button"
                            class="user-menu-button"
                            title="Opciones">
                        <i class="ti ti-dots"></i>
                    </button>

                </div>

            </div>

        </aside>


        <!-- =========================
             CONTENIDO PRINCIPAL
             ========================= -->
        <div class="main-wrapper" id="mainWrapper">

            <!-- Barra superior -->
            <header class="topbar">

                <div class="topbar-left">

                    <button type="button"
                            class="mobile-menu"
                            id="mobileMenu">

                        <i class="ti ti-menu-2"></i>

                    </button>

                    <div>
                        <span class="system-name">
                            Sistema de Gestión Financiera
                        </span>
                    </div>

                </div>


                <div class="topbar-right">

                    <span class="topbar-user">
                        <i class="ti ti-user-circle"></i>
                        Administrador
                    </span>

                    <a href="#"
                       class="logout-button"
                       title="Cerrar sesión">

                        <i class="ti ti-logout"></i>
                        <span>Salir</span>

                    </a>

                </div>

            </header>


            <!-- Contenido de cada página -->
            <main class="page-content">

                <asp:ContentPlaceHolder ID="MainContent" runat="server">
                </asp:ContentPlaceHolder>

            </main>

        </div>

            <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/Scripts/bootstrap.js") %>
    </asp:PlaceHolder>

    </form>

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const sidebar = document.getElementById("sidebar");
            const toggle = document.getElementById("sidebarToggle");
            const mobileMenu = document.getElementById("mobileMenu");

            if (toggle) {

                toggle.addEventListener("click", function () {

                    sidebar.classList.toggle("collapsed");

                    const icon = toggle.querySelector("i");

                    if (sidebar.classList.contains("collapsed")) {
                        icon.className = "ti ti-chevrons-right";
                    } else {
                        icon.className = "ti ti-chevrons-left";
                    }

                });

            }


            if (mobileMenu) {

                mobileMenu.addEventListener("click", function () {
                    sidebar.classList.toggle("mobile-open");
                });

            }

        });

    </script>

</body>
</html>