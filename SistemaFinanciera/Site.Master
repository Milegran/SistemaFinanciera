<%@ Master Language="VB" AutoEventWireup="true" CodeBehind="Site.master.vb" Inherits="SistemaFinanciera.SiteMaster" %>
<!DOCTYPE html><html lang="es"><head runat="server">
<meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
<title><%: Page.Title %> | CapitalWest</title>
<webopt:bundlereference runat="server" path="~/Content/css" />
<link rel="stylesheet" href="<%= ResolveUrl("~/Content/Financiera.css?v=capitalwest-mysql-2") %>" />
<link rel="stylesheet" href="<%= ResolveUrl("~/Content/Stitch.css?v=finanzas-53") %>" />
<asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head><body class="<%= If(Request.AppRelativeCurrentExecutionFilePath.ToLowerInvariant().Contains("/clientes/"), "stitch-clients", If(Request.AppRelativeCurrentExecutionFilePath.ToLowerInvariant().Contains("/simulador/"), "stitch-loans stitch-simulator", If(Request.AppRelativeCurrentExecutionFilePath.ToLowerInvariant().Contains("/prestamos/") OrElse Request.AppRelativeCurrentExecutionFilePath.ToLowerInvariant().Contains("/solicitudes/"), "stitch-loans", If(Request.AppRelativeCurrentExecutionFilePath.ToLowerInvariant().Contains("default.aspx"), "stitch-dashboard", "stitch-finance")))) %>"><form id="form1" runat="server"><div class="stitch-shell">
<asp:ScriptManager runat="server">
            <Scripts>
                <asp:ScriptReference Name="MsAjaxBundle" />
                <asp:ScriptReference Name="jquery" />
                <asp:ScriptReference Name="WebForms.js" Assembly="System.Web"
                    Path="~/Scripts/WebForms/WebForms.js" />
                <asp:ScriptReference Name="WebUIValidation.js" Assembly="System.Web"
                    Path="~/Scripts/WebForms/WebUIValidation.js" />
                <asp:ScriptReference Name="MenuStandards.js" Assembly="System.Web"
                    Path="~/Scripts/WebForms/MenuStandards.js" />
                <asp:ScriptReference Name="GridView.js" Assembly="System.Web"
                    Path="~/Scripts/WebForms/GridView.js" />
                <asp:ScriptReference Name="DetailsView.js" Assembly="System.Web"
                    Path="~/Scripts/WebForms/DetailsView.js" />
                <asp:ScriptReference Name="TreeView.js" Assembly="System.Web"
                    Path="~/Scripts/WebForms/TreeView.js" />
                <asp:ScriptReference Name="WebParts.js" Assembly="System.Web"
                    Path="~/Scripts/WebForms/WebParts.js" />
                <asp:ScriptReference Name="Focus.js" Assembly="System.Web"
                    Path="~/Scripts/WebForms/Focus.js" />
                <asp:ScriptReference Name="WebFormsBundle" />
            </Scripts>
        </asp:ScriptManager>
<header class="cw-topbar">
    <a class="cw-brand" href="<%= ResolveUrl("~/Default.aspx") %>" aria-label="CapitalWest, inicio"><span class="cw-brand-mark"><img src="<%= ResolveUrl("~/Content/Images/capitalwest.png") %>?v=20261024b" alt="" /></span><span>Capital<span class="brand-west">West</span></span><small>PRO</small></a>
    <nav class="cw-topnav" aria-label="Navegación principal"><a class="top-link" data-page="Default.aspx" href="<%= ResolveUrl("~/Default.aspx") %>" title="Inicio" aria-label="Inicio"><span>Inicio</span></a><a class="top-link" data-page="Clientes/Clientes.aspx" href="<%= ResolveUrl("~/Clientes/Clientes.aspx") %>" title="Clientes" aria-label="Clientes"><span>Clientes</span></a><a class="top-link" data-page="Productos/Productos.aspx" href="<%= ResolveUrl("~/Productos/Productos.aspx") %>" title="Productos" aria-label="Productos"><span>Productos</span></a><a class="top-link" data-page="Solicitudes/Solicitudes.aspx" href="<%= ResolveUrl("~/Solicitudes/Solicitudes.aspx") %>" title="Solicitudes" aria-label="Solicitudes"><span>Solicitudes</span></a><a class="top-link" data-page="Prestamos/Prestamos.aspx" href="<%= ResolveUrl("~/Prestamos/Prestamos.aspx") %>" title="Préstamos" aria-label="Préstamos"><span>Préstamos</span></a><a class="top-link" data-page="Pagos/Pagos.aspx" href="<%= ResolveUrl("~/Pagos/Pagos.aspx") %>" title="Pagos" aria-label="Pagos"><span>Pagos</span></a><a class="top-link" data-page="Reportes/Reportes.aspx" href="<%= ResolveUrl("~/Reportes/Reportes.aspx") %>" title="Reportes" aria-label="Reportes"><span>Reportes</span></a><a class="top-link" data-page="Administracion/Usuarios.aspx" href="<%= ResolveUrl("~/Administracion/Usuarios.aspx") %>" title="Administración" aria-label="Administración"><span>Administración</span></a></nav>
    <button type="button" class="cw-header-icon" title="Buscar" aria-label="Buscar"><svg class="cw-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg></button><button type="button" class="cw-header-icon" title="Notificaciones" aria-label="Notificaciones"><svg class="cw-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg><span class="cw-badge"></span></button><div class="cw-profile" title="Usuario autenticado"><span class="profile-avatar" aria-hidden="true"><asp:Literal ID="litUsuarioIniciales" runat="server" Mode="Encode" /></span><span class="cw-profile-info"><strong><asp:Literal ID="litUsuarioNombre" runat="server" Mode="Encode" /></strong><small><asp:Literal ID="litUsuarioRol" runat="server" Mode="Encode" /></small></span></div>
    <button class="cw-menu-toggle" type="button" id="mobileMenu" aria-label="Abrir navegación" aria-controls="sidebar" aria-expanded="false"><svg class="cw-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg></button>
</header>
<button type="button" id="menuBackdrop" class="menu-backdrop" aria-label="Cerrar navegación" hidden></button>
<aside class="cw-rail" id="sidebar" aria-label="Navegación lateral">
    <div class="rail-head"><span class="rail-brand">CW</span><button type="button" id="sidebarExpand" class="rail-expand" aria-controls="sidebarNav" aria-expanded="false" aria-label="Expandir menú">»</button></div>
    <nav id="sidebarNav" aria-label="Menú del sistema">
        <span class="rail-section-label rail-module-label">MÓDULO</span>
        <a class="rail-link rail-module-link rail-module-summary" data-page="Default.aspx" href="<%= ResolveUrl("~/Default.aspx") %>" title="Resumen" aria-label="Resumen"><svg class="cw-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="2"/><rect x="14" y="3" width="7" height="7" rx="2"/><rect x="3" y="14" width="7" height="7" rx="2"/><rect x="14" y="14" width="7" height="7" rx="2"/></svg><span>Resumen</span></a>
        <a class="rail-link rail-module-link" data-page="Prestamos/Prestamos.aspx" href="<%= ResolveUrl("~/Prestamos/Prestamos.aspx") %>" title="Préstamos" aria-label="Préstamos"><svg class="cw-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7.5A2.5 2.5 0 0 1 5.5 5H21v15H5.5A2.5 2.5 0 0 1 3 17.5z"/><path d="M3 8h18M16 13h.01"/></svg><span>Préstamos</span></a>
        <a class="rail-link rail-module-link" href="<%= ResolveUrl("~/Default.aspx#home-vencimientos") %>" title="Alertas" aria-label="Alertas"><svg class="cw-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 9 17H3z"/><path d="M12 9v4m0 3h.01"/></svg><span>Alertas</span></a>
        <span class="rail-divider rail-module-divider"></span><span class="rail-section-label rail-access-label">ACCESOS</span>
        <a class="rail-link rail-access-simulator" data-page="Simulador/Simulador.aspx" href="<%= ResolveUrl("~/Simulador/Simulador.aspx") %>" title="Simulador" aria-label="Simulador"><svg class="cw-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="2" width="14" height="20" rx="3"/><path d="M8 6h8M8 11h.01m4 0h.01m4 0h.01M8 15h.01m4 0h.01m4 0h.01"/></svg><span>Simulador</span></a>
        <a class="rail-link rail-hide-on-loans" data-page="Pagos/Pagos.aspx" href="<%= ResolveUrl("~/Pagos/Pagos.aspx") %>" title="Registrar Pago" aria-label="Registrar Pago"><svg class="cw-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="3"/><path d="M2 10h20m-16 5h4"/></svg><span>Registrar Pago</span></a>
        <a class="rail-link rail-access-request" data-page="Solicitudes/Solicitudes.aspx" href="<%= ResolveUrl("~/Solicitudes/Solicitudes.aspx") %>" title="Nueva Solicitud" aria-label="Nueva Solicitud"><svg class="cw-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zM14 2v6h6M8 13h8m-8 4h6"/></svg><span>Nueva Solicitud</span></a>
        <a class="rail-link rail-access-new-client" data-page="Clientes/Clientes.aspx" href="<%= ResolveUrl("~/Clientes/Clientes.aspx") %>" title="Nuevo Cliente" aria-label="Nuevo Cliente"><svg class="cw-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3"/><path d="M3 21v-3a6 6 0 0 1 12 0v3m2-11V4m-2 2h4"/></svg><span>Nuevo Cliente</span></a>
        <a class="rail-link rail-loans-only" data-page="Prestamos/Prestamos.aspx" href="<%= ResolveUrl("~/Prestamos/Prestamos.aspx") %>" title="Préstamos" aria-label="Préstamos"><svg class="cw-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7.5A2.5 2.5 0 0 1 5.5 5H21v15H5.5A2.5 2.5 0 0 1 3 17.5z"/><path d="M3 8h18M16 13h.01"/></svg><span>Préstamos</span></a>
        <span class="rail-divider rail-system-divider"></span><span class="rail-section-label rail-system-label">SISTEMA</span>
        <a class="rail-link rail-system-settings" data-page="Administracion/Usuarios.aspx" href="<%= ResolveUrl("~/Administracion/Usuarios.aspx") %>" title="Ajustes" aria-label="Ajustes"><svg class="cw-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="m19.4 15 .1.1 1.4 1.1-1.4 2.4-1.7-.7a8 8 0 0 1-1.6.9l-.3 1.8h-2.8l-.3-1.8a8 8 0 0 1-1.6-.9l-1.7.7-1.4-2.4L5.5 15a8 8 0 0 1 0-1.9L4.1 12l1.4-2.4 1.7.7a8 8 0 0 1 1.6-.9l.3-1.8h2.8l.3 1.8a8 8 0 0 1 1.6.9l1.7-.7 1.4 2.4-1.4 1.1a8 8 0 0 1-.1 1.9z"/></svg><span>Ajustes</span></a>
        <asp:LinkButton ID="cerrarSesion" runat="server" Text="Cerrar sesión" ToolTip="Cerrar sesión" aria-label="Cerrar sesión" OnClick="CerrarSesionClick" CssClass="rail-link rail-logout" CausesValidation="false" />
    </nav>
</aside>
<div class="cw-main"><main class="page-content" id="mainContent"><asp:ContentPlaceHolder ID="MainContent" runat="server" /></main>
<footer class="cw-footer"><span>CapitalWest <span class="footer-dot">·</span> Sistema de gestión financiera</span><span>Moneda Balboas (B/.) <span class="footer-dot">·</span> Panamá</span></footer></div>
<script src="<%= ResolveUrl("~/Scripts/CapitalWest.js?v=stitch3") %>"></script>
<script src="<%= ResolveUrl("~/Scripts/FinanzasFormularios.js?v=2") %>"></script>
</div></form></body></html>

