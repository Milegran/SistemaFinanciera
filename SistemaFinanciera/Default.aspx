<%@ Page Title="Inicio" Language="VB" MasterPageFile="~/Site.Master" AutoEventWireup="false" CodeBehind="Default.aspx.vb" Inherits="SistemaFinanciera._Default" %>
<asp:Content ID="DashboardHead" ContentPlaceHolderID="HeadContent" runat="server">
    <style>
        .home-dashboard .home-kpi-heading > span { font-weight: 700 !important; }
    </style>
    <script src="<%= ResolveUrl("~/Scripts/Dashboard.js?v=1") %>" defer="defer"></script>
</asp:Content>
<asp:Content ID="BodyContent" ContentPlaceHolderID="MainContent" runat="server">
<div class="home-dashboard">
    <section class="home-greeting" aria-label="Resumen del día">
        <div class="home-greeting-copy">
            <h1>Te damos la bienvenida, <asp:Literal ID="litNombreUsuario" runat="server" Mode="Encode" /><span class="home-wave" aria-hidden="true">👋</span></h1>
            <p>Resumen de cartera, cobros y vencimientos.</p>
            <label class="home-search" for="dashboardQuickSearch">
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11"  cy="11" r="7"></circle><path d="m16 16 5 5"></path></svg>
                <input id="dashboardQuickSearch" type="search" autocomplete="off" placeholder="Filtrar pagos y cuotas visibles…" />
                <span class="home-search-hint"><kbd>Ctrl</kbd><kbd>K</kbd></span>
            </label>
        </div>
        <div class="home-greeting-actions">
            <div class="home-date-chip"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M16 3v4M8 3v4M3 10h18"></path></svg><span>Corte al <asp:Literal ID="litFechaCorte" runat="server" Mode="Encode" /></span></div>
            <asp:HyperLink ID="lnkAccionPrincipal" runat="server" CssClass="btn btn-primary home-primary-action" Visible="false" />
        </div>
    </section>
    <asp:Panel ID="pnlResumenError" runat="server" CssClass="alert alert-danger" Visible="false">No se pudo cargar el resumen financiero. Inténtelo de nuevo más tarde.</asp:Panel>
    <div class="home-dashboard-layout">
        <div class="home-dashboard-main" role="region" aria-label="Panel financiero">
            <section id="home-kpis" class="home-kpi-grid" aria-label="Indicadores principales">
                <article class="home-kpi home-kpi-featured"><div class="home-kpi-heading"><span>CARTERA TOTAL</span><a href="<%= ResolveUrl("~/Prestamos/Prestamos.aspx") %>" title="Ver cartera" aria-label="Ver cartera de préstamos">↗</a></div><div class="home-kpi-value-block"><strong><asp:Literal ID="litCarteraTotal" runat="server" Mode="Encode" /></strong><p><asp:Literal ID="litPrestamosVigentes" runat="server" Mode="Encode" /> préstamos vigentes</p></div><div class="home-kpi-footer"><span>Monto desembolsado</span><a href="<%= ResolveUrl("~/Prestamos/Prestamos.aspx") %>">Ver cartera <span aria-hidden="true">→</span></a></div></article>
                <article class="home-kpi"><div class="home-kpi-heading"><span>PAGOS DE LA SEMANA</span><a href="<%= ResolveUrl("~/Pagos/Pagos.aspx") %>" title="Ver pagos" aria-label="Ver pagos">↗</a></div><div class="home-kpi-value-block"><strong class="home-kpi-dark"><asp:Literal ID="litPagosSemana" runat="server" Mode="Encode" /></strong><p><asp:Literal ID="litVariacionPagos" runat="server" Mode="PassThrough" /></p></div><div class="home-kpi-footer"><span>Cobros confirmados</span><strong><asp:Literal ID="litTransaccionesSemana" runat="server" Mode="Encode" /> transacciones</strong></div></article>
                <article id="home-vencimientos" class="home-kpi home-kpi-overdue"><div class="home-kpi-heading"><span>PRÉSTAMOS EN MORA</span><b>ALERTA</b></div><div class="home-kpi-value-block"><strong class="home-kpi-red"><asp:Literal ID="litPrestamosMora" runat="server" Mode="Encode" /> <small>casos</small></strong><p class="home-kpi-red-note"><asp:Literal ID="litMontoVencido" runat="server" Mode="Encode" /> vencido</p></div><div class="home-kpi-footer"><span><asp:Literal ID="litIndiceMora" runat="server" Mode="Encode" /></span><a href="<%= ResolveUrl("~/Prestamos/Prestamos.aspx") %>">Ver alertas <span aria-hidden="true">→</span></a></div></article>
                <article class="home-kpi home-kpi-pending"><div class="home-kpi-heading"><span>SOLICITUDES</span><b>PENDIENTES</b></div><div class="home-kpi-value-block"><strong class="home-kpi-amber"><asp:Literal ID="litSolicitudesPendientes" runat="server" Mode="Encode" /> <small>por evaluar</small></strong><p class="home-kpi-amber-note"><asp:Literal ID="litMontoSolicitudesPendientes" runat="server" Mode="Encode" /> solicitados</p></div><div class="home-kpi-footer"><span>En revisión</span><a href="<%= ResolveUrl("~/Solicitudes/Solicitudes.aspx") %>">Revisar <span aria-hidden="true">→</span></a></div></article>
            </section>
            <section id="home-cartera" class="home-dashboard-content-grid" aria-label="Gráficos y próximos vencimientos">
                <article id="home-pagos-mes" class="cw-card home-dashboard-panel home-payment-chart"><div class="home-panel-heading"><div class="home-panel-title"><span class="home-panel-icon" aria-hidden="true">▥</span><div><h2>Pagos recibidos por mes</h2><p>Análisis de cobros y recuperaciones (B/.)</p></div></div><div class="home-chart-tabs" role="group" aria-label="Período del gráfico"><button type="button" class="is-active" data-chart-period="monthly" aria-pressed="true">Mensual</button><button type="button" data-chart-period="yearly" aria-pressed="false">Anual</button></div></div><div class="home-chart-legend"><span><i aria-hidden="true"></i> Pagos aplicados</span><span>Balboas (B/.)</span></div><div id="homeChartMonthly" class="home-bar-chart"><asp:Literal ID="litChartMensual" runat="server" Mode="PassThrough" /></div><div id="homeChartYearly" class="home-bar-chart" hidden="hidden"><asp:Literal ID="litChartAnual" runat="server" Mode="PassThrough" /></div><div class="home-chart-footer"><span>Fuente: pagos confirmados en CapitalWest</span><a href="<%= ResolveUrl("~/Pagos/Pagos.aspx") %>">Ver pagos <span aria-hidden="true">→</span></a></div></article>
                <div class="home-dashboard-side-stack">
                    <article class="cw-card home-dashboard-panel home-balance-panel"><div class="home-panel-heading"><div><h2>Saldo pendiente</h2><p>Importes exigibles de préstamos activos</p></div><a class="home-icon-link" href="<%= ResolveUrl("~/Prestamos/Prestamos.aspx") %>" title="Ver cartera" aria-label="Ver cartera">↗</a></div><div class="home-balance-main"><span id="homeBalanceLabel">Capital pendiente</span><strong id="homeBalanceValue" runat="server" ClientIDMode="Static" data-capital="" data-interest="">B/. 0.00</strong></div><div class="home-balance-composition" aria-label="Capital pendiente e interés exigible"><span id="homeCapitalPart" runat="server" ClientIDMode="Static"></span><span id="homeInterestPart" runat="server" ClientIDMode="Static"></span></div><div class="home-balance-legend"><span><i class="is-capital"></i>Capital</span><span><i class="is-interest"></i>Interés exigible</span></div><div class="home-balance-tabs" role="group" aria-label="Tipo de saldo"><button type="button" class="is-active" data-balance-type="capital" aria-pressed="true">Capital <span>↑</span></button><button type="button" data-balance-type="interest" aria-pressed="false">Intereses <span>↓</span></button></div></article>
                    <article class="cw-card home-interest-card"><div class="home-interest-heading"><span aria-hidden="true">%</span><div><h2>Intereses cobrados</h2><p>Acumulado en el mes actual</p></div></div><strong><asp:Literal ID="litInteresesMes" runat="server" Mode="Encode" /></strong><span class="home-interest-caption">Aplicados a pagos confirmados</span></article>
                    <article class="cw-card home-due-soon-card"><div class="home-panel-heading"><div><h2>Cuotas por vencer</h2><p>Dentro de las próximas 72 horas</p></div><a class="home-icon-link" href="#home-cuotas" title="Ver calendario" aria-label="Ver cuotas próximas">↗</a></div><div class="home-due-soon-summary"><strong><asp:Literal ID="litCuotas72h" runat="server" Mode="Encode" /></strong><span>cuotas · <asp:Literal ID="litMontoCuotas72h" runat="server" Mode="Encode" /></span></div><div class="home-due-avatars"><asp:Literal ID="litAvataresCuotas" runat="server" Mode="PassThrough" /></div><a class="home-more-link" href="#home-cuotas">Ver próximas cuotas <span aria-hidden="true">→</span></a></article>
                </div>
            </section>
            <section id="home-cuotas" class="home-dashboard-tables" aria-label="Actividad de pagos y vencimientos">
                <article class="cw-card home-dashboard-panel home-recent-payments"><div class="home-panel-heading"><div><h2>Últimos pagos</h2><p>Pagos confirmados recientemente</p></div><a class="home-icon-link" href="<%= ResolveUrl("~/Pagos/Pagos.aspx") %>" title="Ver pagos" aria-label="Ver todos los pagos">↗</a></div><div class="home-payment-list"><asp:Literal ID="litPagosRecientes" runat="server" Mode="PassThrough" /></div><div class="home-table-footer"><span>Historial de caja</span><a href="<%= ResolveUrl("~/Pagos/Pagos.aspx") %>">Ver todos <span aria-hidden="true">→</span></a></div></article>
                <article class="cw-card home-dashboard-panel home-upcoming-payments"><div class="home-panel-heading"><div><h2>Próximas cuotas a vencer</h2><p>Compromisos de pago dentro de los siguientes 10 días</p></div><a class="home-icon-link" href="<%= ResolveUrl("~/Prestamos/Prestamos.aspx") %>" title="Ver préstamos" aria-label="Ver préstamos">↗</a></div><div class="home-table-scroll"><table class="home-due-table"><thead><tr><th>Cliente</th><th>Vencimiento</th><th>Monto</th><th>Estado</th></tr></thead><tbody><asp:Literal ID="litCuotasProximas" runat="server" Mode="PassThrough" /></tbody></table></div><div class="home-table-footer"><span>Total a recaudar: <strong><asp:Literal ID="litTotalCuotas10Dias" runat="server" Mode="Encode" /></strong></span><a href="<%= ResolveUrl("~/Prestamos/Prestamos.aspx") %>">Gestionar cartera <span aria-hidden="true">→</span></a></div></article>
            </section>
        </div>
    </div>
</div>
</asp:Content>
